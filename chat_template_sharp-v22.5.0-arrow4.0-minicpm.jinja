                    {%- set _note.err = true %}
                {%- elif _err_n >= 2 %}
                    {%- set _note.t = 'SYSTEM NOTE: same error, ' ~ (_err_n + 1) ~ 'x. Guessing failed. Stop re-deriving: use data already shown, ' ~ (('look fact up now (' ~ _wt.n ~ ': spec, docs)') if _wt.n else 'look fact up (docs, spec, --help)') ~ ', or drop route.' ~ (' Question -> answer with what is known.' if ns2.ask else '') %}
                    {%- set _note.err = true %}
                {%- elif _err_again %}
                    {%- set _note.t = 'SYSTEM NOTE: same error as before. Retrying variants = no fix. Fix named cause (path, workdir, missing piece) or drop route.' %}
                    {%- set _note.err = true %}
                {%- elif _notfound %}
                    {%- set _note.t = 'SYSTEM NOTE: path not found. Locate by file-name search. No guessing.' %}
                    {%- set _note.err = true %}
                {%- elif ns2.consecutive_failures >= 3 %}
                    {%- set _note.t = 'SYSTEM NOTE: ' ~ ns2.consecutive_failures ~ ' errors in a row. Name cause in 1 line, switch route.' %}
                    {%- set _note.err = true %}
                {%- endif %}
            {%- endif %}
            {%- set _t_pl = _t_path | lower %}
            {%- set _t_outfp = _t_change and ns2.root and (_t_pl.startswith('/') or ':/' in _t_pl[:3]) and not _t_pl.startswith((ns2.root | lower) ~ '/') and not _t_pl.startswith('/tmp/') and not ('/.arrow/' in _t_pl) %}
            {%- set _t_outp = _t_path if _t_outfp else (_qf[6] if _qf | length > 6 else '') %}
            {%- if not _note.t and _t_outp and not _this_err %}
                {%- set _note.t = 'SYSTEM NOTE: wrote outside project root (' ~ ns2.root ~ '): ' ~ _t_outp ~ '. Plan approval and mentions != permission. Outside only if user asked to change it there. Else stop, work in scope, list stray file in report.' %}
            {%- endif %}
            {%- if _t_name and 'skill' in _t_name and ('view' in _t_name or 'load' in _t_name) and not _this_err %}
                {%- set ns2.skills_seen = ns2.skills_seen + 1 %}
                {%- if not _note.t and ns2.skills_seen >= 2 %}
                    {%- set _note.t = 'SYSTEM NOTE: skill #' ~ ns2.skills_seen ~ ' this task. Skills = side quest. Stop loading, act.' %}
                {%- endif %}
            {%- endif %}
            {%- if not _note.t and ns2.probe_due %}
                {%- set ns2.probe_due = false %}
                {%- set _note.t = ('SYSTEM NOTE: ' ~ ns2.probes ~ ' probe scripts, no change. Probing loop. Next: change something, or report what blocks.') if ns2.probes >= 9 else ('SYSTEM NOTE: ' ~ ns2.probes ~ ' probe scripts since last change. Probing != progress. Output shown = known. Decide from it, ' ~ ('present plan.' if ns2.gate else ('answer.' if ns2.ask else 'move.'))) %}
            {%- endif %}
            {%- set _nag = ('todo' in _content_lower or 'plan' in _content_lower) and ('declare' in _content_lower or 'no plan' in _content_lower or 'consider using' in _content_lower or 'not been used' in _content_lower) %}
            {%- if not _note.t and _nag and (_t_change or '.arrow/' in _t_path) and (ns2.ask or not ns2.writes) %}
                {%- set _note.t = 'SYSTEM NOTE: harness plan prompt. ' ~ ('Plan stage -> skip it, continue.' if ns2.gate else ('Question -> skip it, continue.' if ns2.ask else 'It counted .arrow writes only. Skip it, continue.')) %}
            {%- endif %}
            {%- if not _note.t and _t_dup %}
                {%- set _note.t = 'SYSTEM NOTE: already above (same call / file read in full), nothing changed. Use it. Next step.' %}
            {%- endif %}
            {%- if not _note.t and _zero and ns2.zero_run >= 2 and not ns2.zb %}
                {%- set ns2.zb = true %}
                {%- set _note.t = 'SYSTEM NOTE: ' ~ ns2.zero_run ~ ' empty searches since last change. Not there = fact. Stop variants. Act.' %}
            {%- endif %}
            {%- if not _note.t and ns2.since_change >= ns2.next_stall %}
                {%- if ns2.ask %}
                    {%- set _note.t = 'SYSTEM NOTE: ' ~ ns2.since_change ~ (' calls. Plan asked, not work. Present plan + ask approval now. No changes before yes.' if ns2.gate else ' calls on a question. Enough known. Answer now: facts, estimate, what would confirm it. No building.') %}
                {%- elif ns2.since_change < 24 %}
                    {%- set _note.t = 'SYSTEM NOTE: ' ~ ns2.since_change ~ ' calls, no change. Enough known. Needs change -> smallest testing change now. Question/check -> answer now. 1 fact missing -> get only that.' %}
                {%- else %}
                    {%- set _note.t = 'SYSTEM NOTE: ' ~ ns2.since_change ~ ' calls, still no change. Stop investigating. Deliver now: change, or answer/report, or 1 line: what blocks.' %}
                {%- endif %}
                {%- set ns2.next_stall = ns2.since_change + (6 if ns2.ask else 12) %}
            {%- endif %}
            {%- if not _note.t and _t_verify and not _this_err and ns2.writes and not ns2.vb %}
                {%- set ns2.vb = true %}
                {%- set _note.t = 'SYSTEM NOTE: check passed. Goal met -> ' ~ ('close .arrow plan, ' if ns2.plan_open else '') ~ 'deliver report now (changed, verified, left). Else next step only.' %}
            {%- endif %}
            {%- if not _note.t and _think_long %}
                {%- set _note.t = 'SYSTEM NOTE: long think, read-only step. Think once, act: 1-2 lines/step, batch all ready calls.' %}
            {%- endif %}
            {%- if not _note.t and _big %}
                {%- set _note.t = 'SYSTEM NOTE: result >30k chars. Next: search first, read only needed lines.' %}
            {%- endif %}
        {%- endif %}
        {%- if _arrow_active and not _note.t %}
            {%- if _hard_won %}
                {%- set _note.t = 'SYSTEM NOTE: worked after failures. Matters again -> 1 line in .arrow/memory.' %}
            {%- elif ns2.arrow_calls_total >= 10 and not ns2.ask and not ns2.plan_seen and not ns2.plan_nudged %}
                {%- set ns2.plan_nudged = true %}
                {%- set _note.t = 'SYSTEM NOTE: 10 calls, no plan. Multi-step -> short plan now: .arrow/plans/<four-random-words>.md (goal, - [ ] steps, verify).' %}
            {%- elif not ns2.ask and ns2.calls_arrow >= ns2.next_mem %}
                {%- set ns2.next_mem = ns2.calls_arrow + 30 %}
                {%- set _note.t = 'SYSTEM NOTE: ' ~ ns2.calls_arrow ~ ' calls since last .arrow update. Learned something reusable (decision, command, trap)? -> 1 line in .arrow/memory. Else skip.' %}
            {%- elif not ns2.arrow_seen and not ns2.arrow_read_nudged %}
                {%- set ns2.arrow_read_nudged = true %}
                {%- set _note.t = 'SYSTEM NOTE: .arrow/ untouched. Exists -> read memory/INDEX.md + plans/INDEX.md once. Missing -> create now (both INDEX.md + .gitignore *).' %}
            {%- endif %}
        {%- endif %}
        {%- if _this_err and not _note.err %}
            {%- if ns2.consecutive_failures >= 2 %}
                {{- '\n\nSYSTEM WARNING: ' ~ ns2.consecutive_failures ~ ' errors in a row. Same failing step -> stop, change approach.' }}
            {%- else %}
                {{- '\n\nSYSTEM WARNING: error. Call wrong -> fix call. Real problem -> fix problem.' }}
            {%- endif %}
        {%- endif %}
        {%- if _note.t %}
            {{- '\n\n' ~ _note.t }}
            {#- Corrective notes are decision points: the next turn gets to think. #}
            {%- if not ('long think' in _note.t or '>30k' in _note.t or '.arrow' in _note.t or 'worked after failures' in _note.t or 'rewritten whole' in _note.t or 'check passed' in _note.t or 'plan prompt' in _note.t or 'skill #' in _note.t) %}
                {%- set ns2.b_focus = true %}
            {%- endif %}
        {%- endif %}
        {#- STATUS: the freshest spot in context carries the working memory, every batch. #}
        {%- set _batch_end = loop.last or _msgs[loop.index0 + 1].role != 'tool' %}
        {%- if _agent_on and _status_on and _batch_end %}
            {%- set _hs = namespace(t='STATUS step ' ~ ns2.turns ~ ' (known, no re-check)') %}
            {%- if ns2.goal %}
                {%- set _hs.t = _hs.t ~ ' | goal: ' ~ ns2.goal %}
            {%- endif %}
            {%- if ns2.root %}
                {%- set _hs.t = _hs.t ~ ' | scope: ' ~ ns2.root %}
            {%- endif %}
            {%- set _calls = ns2.since_change ~ (' call' if ns2.since_change == 1 else ' calls') %}
            {%- if ns2.ask %}
                {%- set _hs.t = _hs.t ~ ' | ' ~ _calls ~ (' since plan ask' if ns2.gate else ' on this question') ~ ((' (last change: ' ~ ns2.last_act ~ ')') if ns2.last_act else '') %}
            {%- elif ns2.last_act and ns2.since_change == 0 %}
                {%- set _hs.t = _hs.t ~ ' | just did: ' ~ ns2.last_act %}
            {%- elif ns2.last_act %}
                {%- set _hs.t = _hs.t ~ ' | ' ~ _calls ~ ' since last change (' ~ ns2.last_act ~ ')' %}
            {%- else %}
                {%- set _hs.t = _hs.t ~ ' | ' ~ _calls ~ ', no change yet' %}
            {%- endif %}
            {%- if ns2.h_reads %}
                {%- set _hr = ns2.h_reads.split('~$~') %}
                {%- set _hs.t = _hs.t ~ ' | read: ' ~ (_hr[-4:] | join(', ')) ~ ((' +' ~ ((_hr | length) - 4)) if (_hr | length) > 4 else '') %}
            {%- endif %}
            {%- if ns2.h_empty %}
                {%- set _hs.t = _hs.t ~ ' | empty: ' ~ (ns2.h_empty.split('~$~')[-3:] | join(', ')) %}
            {%- endif %}
            {%- if ns2.h_dead %}
                {%- set _hs.t = _hs.t ~ ' | missing: ' ~ (ns2.h_dead.split('~$~')[-3:] | join(', ')) %}
            {%- endif %}
            {%- if ns2.writes %}
                {%- set _hs.t = _hs.t ~ ' | changed: ' ~ (ns2.writes.split('~$~')[-4:] | join(', ')) %}
            {%- endif %}
            {%- if ns2.now %}
                {%- set _hs.t = _hs.t ~ ' | now: ' ~ ns2.now %}
            {%- endif %}
            {%- if _arrow_active and ns2.arrow_missing %}
                {%- set _hs.t = _hs.t ~ (' | .arrow: missing -> create before answering (1 batch)' if (ns2.ask and not ns2.gate) else ' | .arrow: missing -> create now (1 batch)') %}
            {%- endif %}
            {%- set _mm = namespace(m='') %}
            {%- for _l in ns2.mem_links.split('~$~') %}
                {%- if _l and not _mm.m and ('~$~' ~ _l ~ '~$~') not in ('~$~' ~ ns2.mem_files ~ '~$~') %}
                    {%- set _mm.m = _l %}
                {%- endif %}
            {%- endfor %}
            {%- if _arrow_active and ns2.ask and not ns2.gate and (ns2.plan_open or _mm.m) %}
                {%- set _hs.t = _hs.t ~ ' | .arrow: before answering -> ' ~ ('close plan + ' if ns2.plan_open else '') ~ 'fix facts that changed' ~ ((', write ' ~ _mm.m) if _mm.m else '') ~ ' (1 batch)' %}
            {%- elif _arrow_active and ns2.plan_open and ns2.now.startswith('all steps done') %}
                {%- set _hs.t = _hs.t ~ ' | .arrow: close plan (result + status: done), fix facts that changed' %}
            {%- elif _arrow_active and _mm.m %}
                {%- set _hs.t = _hs.t ~ ' | .arrow: INDEX links unwritten ' ~ _mm.m %}
            {%- elif _arrow_active and ns2.plan_open and ns2.chg_arrow >= 6 %}
                {%- set _hs.t = _hs.t ~ ' | .arrow: tick plan (' ~ ns2.chg_arrow ~ ' changes since)' %}
            {%- endif %}
            {#- Pressure rises with inaction, like a presence penalty on reading: the longer nothing changes, the harder the push. #}
            {%- set _hb_at = (_deliver_q if ns2.ask else _deliver_at) %}
            {%- if _hb_at > 0 and ns2.since_change >= _hb_at %}
                {%- set _hs.t = _hs.t ~ ' | HANDBACK: report now (done, blocker, options)' %}
            {%- elif ns2.ask and ns2.since_change >= 10 %}
                {%- set _hs.t = _hs.t ~ (' | STALLED: present plan + ask approval now' if ns2.gate else ' | STALLED: answer the question now') %}
            {%- elif ns2.ask and ns2.since_change >= 5 %}
                {%- set _hs.t = _hs.t ~ (' | overdue: present plan now' if ns2.gate else ' | overdue: answer now from known facts') %}
            {%- elif ns2.ask %}
                {%- set _hs.t = _hs.t ~ (((' | plan asked: every file inside scope ' ~ ns2.root ~ ', present it, wait for yes') if ns2.root else ' | plan asked: present it, then wait for yes') if ns2.gate else ' | question: answer once facts suffice') %}
            {%- elif ns2.since_change >= 12 %}
                {%- set _hs.t = _hs.t ~ ' | STALLED: deliver now' %}
            {%- elif ns2.since_change >= 8 %}
                {%- set _hs.t = _hs.t ~ ' | overdue: change or report now' %}
            {%- elif ns2.since_change >= 4 %}
                {%- set _hs.t = _hs.t ~ ' | next: act or report' %}
            {%- elif ns2.b_err %}
                {%- set _hs.t = _hs.t ~ ' | next: fix named cause -> move' %}
            {%- elif ns2.since_change == 0 and ns2.last_act.startswith('ran') %}
                {%- set _hs.t = _hs.t ~ ' | next: conclude from result -> move' %}
            {%- elif ns2.since_change == 0 and ns2.last_act %}
                {%- set _hs.t = _hs.t ~ ' | next: measure it (run/check)' %}
            {%- else %}
                {%- set _hs.t = _hs.t ~ ' | next: conclude -> move (act or report)' %}
            {%- endif %}
            {{- '\n\n' ~ _hs.t }}
        {%- endif %}
        {{- '\n</tool_response>' }}
        {%- if loop.last %}
            {{- '<|im_end|>\n' }}
        {%- else %}
            {%- set _next_role = _msgs[loop.index0 + 1].role %}
            {%- if _next_role != 'tool' %}
                {{- '<|im_end|>\n' }}
            {%- endif %}
        {%- endif %}
    {%- else %}
        {{- '<|im_start|>user\n[' + message.role + ']: ' + content + '<|im_end|>\n' }}
    {%- endif %}
    {%- set ns2.prev_role = message.role %}
{%- endfor %}
{%- if add_generation_prompt %}
    {{- '<|im_start|>assistant\n' }}
    {#- Think cadence: think at decision points (after a user message, an error, a corrective note, or every
        act_streak turns); otherwise the think block arrives closed and the model acts directly. #}
    {%- set _cad_act = _agent_on and _cadence_on and ns_state.thinking and ns2.prev_role == 'tool' and (ns2.act_run + 1) < _act_streak_max and ((not ns2.b_err and not ns2.b_focus) or ns2.act_run < 2) %}
    {%- set _hb_at2 = (_deliver_q if ns2.ask else _deliver_at) %}
    {%- set _hb = _agent_on and _hb_at2 > 0 and ns2.prev_role == 'tool' and ns2.since_change >= _hb_at2 %}
    {%- if _hb %}
        {{- '<think>\n\n</think>\n\n' ~ ('Plan:\n' if ns2.gate else ('Answer from what is known:\n' if ns2.ask else 'Report - done so far, what blocks, options:\n')) }}
    {%- elif not ns_state.thinking or _cad_act %}
        {{- '<think>\n\n</think>\n\n' }}
    {%- else %}
        {{- '<think>\n' }}
    {%- endif %}
{%- endif %}