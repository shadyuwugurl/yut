{%- set template_version = "qwen3.8-sharp-v22.5.0-arrow4.0-minicpm" %}
{%- set _tool_format = tool_call_format if tool_call_format is defined else 'xml' %}
{%- set image_count = namespace(value=0) %}
{%- set video_count = namespace(value=0) %}
{%- set add_vision_id = add_vision_id if add_vision_id is defined else false %}
{%- set enable_thinking = enable_thinking if enable_thinking is defined else true %}
{%- set auto_disable_thinking_with_tools = auto_disable_thinking_with_tools if auto_disable_thinking_with_tools is defined else false %}
{%- if preserve_reasoning is defined and preserve_reasoning is not none %}
    {%- set _preserve_thinking = preserve_reasoning %}
{%- elif preserve_thinking is defined and preserve_thinking is not none %}
    {%- set _preserve_thinking = preserve_thinking %}
{%- else %}
    {%- set _preserve_thinking = true %}
{%- endif %}
{%- set max_tool_arg_chars = max_tool_arg_chars if max_tool_arg_chars is defined else 0 %}
{%- set max_tool_response_chars = max_tool_response_chars if max_tool_response_chars is defined else 0 %}
{%- set _default_reasoning_effort = 'medium' %}
{%- set _has_tools = (tools is defined and tools and tools is iterable and tools is not mapping) %}
{%- set _effort_raw = (reasoning_effort | string | lower) if reasoning_effort is defined and reasoning_effort is not none else _default_reasoning_effort %}
{%- set _initial_thinking = enable_thinking %}
{%- if _effort_raw in ('none', 'off') %}
    {%- set _initial_thinking = false %}
    {%- set _initial_effort = 'medium' %}
{%- elif _effort_raw in ('minimal', 'low') %}
    {%- set _initial_effort = 'low' %}
{%- elif _effort_raw in ('high', 'xhigh', 'max', 'ultracode', 'extreme') %}
    {%- set _initial_effort = 'xhigh' %}
{%- else %}
    {%- set _initial_effort = 'medium' %}
{%- endif %}
{%- set ns_state = namespace(thinking=_initial_thinking, effort=_initial_effort) %}
{%- if auto_disable_thinking_with_tools and _has_tools %}
    {%- set ns_state.thinking = false %}
{%- endif %}
{%- for msg in messages %}
    {%- if msg.role == 'system' or msg.role == 'developer' or msg.role == 'user' %}
        {%- if msg.content is string %}
            {%- if '<|think_off|>' in msg.content %}
                {%- set ns_state.thinking = false %}
            {%- elif '<|think_on|>' in msg.content %}
                {%- set ns_state.thinking = true %}
            {%- elif '<|think_xhigh|>' in msg.content or '<|think_high|>' in msg.content or '<|think_ultracode|>' in msg.content or '<|think_extreme|>' in msg.content or '<|think_max|>' in msg.content %}
                {%- set ns_state.thinking = true %}
                {%- set ns_state.effort = 'xhigh' %}
            {%- elif '<|think_low|>' in msg.content or '<|think_minimal|>' in msg.content %}
                {%- set ns_state.thinking = true %}
                {%- set ns_state.effort = 'low' %}
            {%- elif '<|think_medium|>' in msg.content %}
                {%- set ns_state.thinking = true %}
                {%- set ns_state.effort = 'medium' %}
            {%- endif %}
        {%- elif msg.content is iterable and msg.content is not mapping %}
            {%- for item in msg.content %}
                {%- if item is string %}
                    {%- set _item_text = item %}
                {%- elif item is mapping and 'text' in item and item.text is string %}
                    {%- set _item_text = item.text %}
                {%- else %}
                    {%- set _item_text = '' %}
                {%- endif %}
                {%- if _item_text %}
                    {%- if '<|think_off|>' in _item_text %}
                        {%- set ns_state.thinking = false %}
                    {%- elif '<|think_on|>' in _item_text %}
                        {%- set ns_state.thinking = true %}
                    {%- elif '<|think_xhigh|>' in _item_text or '<|think_high|>' in _item_text or '<|think_ultracode|>' in _item_text or '<|think_extreme|>' in _item_text or '<|think_max|>' in _item_text %}
                        {%- set ns_state.thinking = true %}
                        {%- set ns_state.effort = 'xhigh' %}
                    {%- elif '<|think_low|>' in _item_text or '<|think_minimal|>' in _item_text %}
                        {%- set ns_state.thinking = true %}
                        {%- set ns_state.effort = 'low' %}
                    {%- elif '<|think_medium|>' in _item_text %}
                        {%- set ns_state.thinking = true %}
                        {%- set ns_state.effort = 'medium' %}
                    {%- endif %}
                {%- endif %}
            {%- endfor %}
        {%- endif %}
    {%- endif %}
{%- endfor %}
{%- set reasoning_instructions = '' %}
{%- if ns_state.thinking %}
    {%- if ns_state.effort == 'xhigh' %}
        {%- if _has_tools %}
            {%- set reasoning_instructions = 'Reasoning effort xhigh: think deep only at decision points (start, errors, surprises). Then act, no re-thinking settled steps.' %}
        {%- else %}
            {%- set reasoning_instructions = 'Reasoning effort is set to xhigh. Please think carefully through the task, validate key assumptions, consider plausible alternatives, and prioritize correctness, consistency, and clarity in the final answer.' %}
        {%- endif %}
    {%- elif ns_state.effort == 'low' %}
        {%- set reasoning_instructions = 'Reasoning effort is set to low. Keep your thinking brief and focused, moving directly to the conclusion without unnecessary elaboration.' %}
    {%- endif %}
{%- endif %}
{%- macro render_content(content, do_vision_count, is_system_content=false) %}
    {%- if content is string %}
        {{- content }}
    {%- elif content is iterable and content is not mapping %}
        {%- for item in content %}
            {%- if not loop.first %}{{- '\n' }}{%- endif %}
            {%- if item is mapping %}
                {%- if item.type == 'image' or 'image' in item or 'image_url' in item %}
                    {%- if is_system_content %}
                        {{- raise_exception('System message cannot contain images.') }}
                    {%- endif %}
                    {%- if do_vision_count %}
                        {%- set image_count.value = image_count.value + 1 %}
                    {%- endif %}
                    {%- if add_vision_id %}
                        {{- 'Picture ' ~ image_count.value ~ ': ' }}
                    {%- endif %}
                    {{- '<|image_pad|>' }}
                {%- elif item.type == 'video' or 'video' in item or 'video_url' in item %}
                    {%- if is_system_content %}
                        {{- raise_exception('System message cannot contain videos.') }}
                    {%- endif %}
                    {%- if do_vision_count %}
                        {%- set video_count.value = video_count.value + 1 %}
                    {%- endif %}
                    {%- if add_vision_id %}
                        {{- 'Video ' ~ video_count.value ~ ': ' }}
                    {%- endif %}
                    {{- '<|video_pad|>' }}
                {%- elif 'text' in item %}
                    {{- item.text }}
                {%- else %}
                    {{- raise_exception('Unexpected item type in content.') }}
                {%- endif %}
            {%- else %}
                {{- item | string }}
            {%- endif %}
        {%- endfor %}
    {%- elif content is none or content is undefined %}
        {{- '' }}
    {%- else %}
        {{- raise_exception('Unexpected content type.') }}
    {%- endif %}
{%- endmacro %}
{%- if not messages %}
    {{- raise_exception('No messages provided.') }}
{%- endif %}
{%- set head = namespace(count=0, seen_non_system=false) %}
{%- for message in messages %}
    {%- set _is_sys = (message.role == 'system' or message.role == 'developer') %}
    {%- if _is_sys and not head.seen_non_system %}
        {%- set head.count = head.count + 1 %}
    {%- else %}
        {%- set head.seen_non_system = true %}
    {%- endif %}
{%- endfor %}
{%- set sys_state = namespace(content='') %}
{%- for message in messages[:head.count] %}
    {%- set _part = render_content(message.content, false, true) | trim %}
    {%- if '<|think_off|>' in _part %}{%- set _part = _part.split('<|think_off|>') | join('') | trim %}{%- endif %}
    {%- if '<|think_on|>' in _part %}{%- set _part = _part.split('<|think_on|>') | join('') | trim %}{%- endif %}
    {%- if '<|think_xhigh|>' in _part %}{%- set _part = _part.split('<|think_xhigh|>') | join('') | trim %}{%- endif %}
    {%- if '<|think_high|>' in _part %}{%- set _part = _part.split('<|think_high|>') | join('') | trim %}{%- endif %}
    {%- if '<|think_ultracode|>' in _part %}{%- set _part = _part.split('<|think_ultracode|>') | join('') | trim %}{%- endif %}
    {%- if '<|think_extreme|>' in _part %}{%- set _part = _part.split('<|think_extreme|>') | join('') | trim %}{%- endif %}
    {%- if '<|think_max|>' in _part %}{%- set _part = _part.split('<|think_max|>') | join('') | trim %}{%- endif %}
    {%- if '<|think_medium|>' in _part %}{%- set _part = _part.split('<|think_medium|>') | join('') | trim %}{%- endif %}
    {%- if '<|think_low|>' in _part %}{%- set _part = _part.split('<|think_low|>') | join('') | trim %}{%- endif %}
    {%- if '<|think_minimal|>' in _part %}{%- set _part = _part.split('<|think_minimal|>') | join('') | trim %}{%- endif %}
    {%- if _part %}
        {%- if sys_state.content %}
            {%- set sys_state.content = sys_state.content ~ '\n\n' ~ _part %}
        {%- else %}
            {%- set sys_state.content = _part %}
        {%- endif %}
    {%- endif %}
{%- endfor %}
{%- set _sc = sys_state.content %}
{%- set _msgs = messages[head.count:] %}
{%- if ns_state.thinking %}
    {%- set _terse_lead = 'Answer directly, after thinking. Lead with the answer, then only what it needs to be correct and usable.' %}
{%- else %}
    {%- set _terse_lead = 'Answer directly and concisely. Give the answer with only what it needs to be correct and usable.' %}
{%- endif %}
{%- set _terse_core %}
Never: open with preamble or pleasantries; restate the question; add filler transitions; hedge with niceties; or repeat a point you've already made.
Always: keep essential steps, caveats, uncertainties, and specifics — never drop correctness or a needed warning for brevity. Keep the final answer lean. Use the least structure that conveys it (plain prose when short; lists or code only when they earn their place). If genuinely uncertain, say so and explain why — never omit uncertainty for the sake of brevity.
{%- endset %}
{%- if _has_tools %}
    {%- set _ask_rule = "Truly ambiguous and tools can't settle it -> ask one sharp question. Else decide, proceed." %}
{%- else %}
    {%- set _ask_rule = "If a user request is genuinely ambiguous, ask a sharp question, don't guess." %}
{%- endif %}
{%- set _terse = _terse_lead ~ '\n' ~ (_terse_core | trim) ~ '\n' ~ _ask_rule %}
{%- set _decisive_on = decisive if decisive is defined else true %}
{%- set _terse_on = terse if terse is defined else true %}
{%- set _agent_on = _has_tools and _decisive_on %}
{#- 3.3: think cadence (thinking only at decision points) and a per-batch STATUS line. Both can be switched off by kwargs. #}
{%- set _cadence_on = think_cadence if (think_cadence is defined and think_cadence is not none) else true %}
{%- set _act_streak_max = act_streak if (act_streak is defined and act_streak is not none) else 8 %}
{%- set _status_on = status_line if (status_line is defined and status_line is not none) else true %}
{%- set _deliver_at = deliver_at if (deliver_at is defined and deliver_at is not none) else 36 %}
{%- set _deliver_q = deliver_at_question if (deliver_at_question is defined and deliver_at_question is not none) else (18 if _deliver_at > 0 else 0) %}
{#- Agent mode: the brain-to-hands bridge. Every line answers "what do I do next", not "how should I feel". #}
{%- set _agent_core %}
Agent mode. Think once, then act.
- Plan once, short. Then per step 1-2 lines: last result -> next action. Re-plan only if a result breaks the plan. Never restate task.
- Seen once = known. No re-read, re-search, re-run, re-check. Nothing found = not there. Error = its cause. Act on it.
- Memory vs live evidence disagree -> live wins. Fix memory now (harness memory + .arrow), then proceed. No deliberating.
- Goal = delivery. Evidence enough -> stop collecting, deliver. Question/check only -> answer from evidence, don't build.
- Task needs a change -> smallest change that tests it (write, build, run). Reading without changing = failure.
- Stay on the ask. Side issue -> 1 line in report, don't chase.
- Scope = project root (working dir). Paths user only mentions = context, not target. Files outside only if user says change them there.
- Where things live (paths, URLs, ports) = check live config once, read-only. URL path != file path. Never assume.
- Batch all independent calls. Search first, read only needed lines.
- Fix in place: edit broken part only, never rewrite whole file.
- Long job (build, download, test suite) -> background with log, other steps meanwhile, then check log. Build only needed targets.
- Third-party clones/builds -> /tmp. Project gets only what it ships.
- STATUS line after each batch = known facts. Trust it, no re-check. Turn opens with thinking closed -> act directly.
- After summary: trust it, continue next open step.
- Approval given stays given. Confirm only delete / overwrite / irreversible.
{%- endset %}
{%- set _agent_reply = '- Replies: same language as user. Result first. No preamble, filler, recap. Keep needed caveats. ' ~ _ask_rule ~ '\n- Done: changed, verified, left.' %}
{%- set _wt = namespace(n='') %}
{%- if _agent_on %}
    {%- for _t in tools %}
        {%- if not _wt.n and _t is mapping and _t.function is defined and _t.function is mapping and _t.function.name is defined and 'web' in (_t.function.name | string | lower) and 'search' in (_t.function.name | string | lower) %}
            {%- set _wt.n = _t.function.name | string %}
        {%- endif %}
    {%- endfor %}
{%- endif %}
{%- set _sk = namespace(found=false) %}
{%- if _agent_on %}
    {%- for _t in tools %}
        {%- if _t is mapping and _t.function is defined and _t.function is mapping and _t.function.name is defined %}
            {%- set _skn = _t.function.name | string %}
        {%- elif _t is mapping and _t.name is defined %}
            {%- set _skn = _t.name | string %}
        {%- else %}
            {%- set _skn = '' %}
        {%- endif %}
        {%- if 'skill' in (_skn | lower) %}
            {%- set _sk.found = true %}
        {%- endif %}
    {%- endfor %}
    {%- set _blk = _agent_core | trim %}
    {%- if _sk.found %}
        {%- set _blk = _blk ~ '\n- Skills: load only one that names this task, once.' %}
    {%- endif %}
    {%- if _terse_on %}
        {%- set _blk = _blk ~ '\n' ~ _agent_reply %}
    {%- endif %}
{%- elif _terse_on %}
    {%- set _blk = _terse | trim %}
{%- else %}
    {%- set _blk = '' %}
{%- endif %}
{%- set _arrow_mode = (arrow_memory if (arrow_memory is defined and arrow_memory is not none) else true) | string | lower %}
{%- set _arrow_on = _arrow_mode not in ('false', 'off', '0', 'no', 'none') %}
{%- set _arrow_always = _arrow_mode == 'always' %}
{%- set _fs = namespace(ok=false) %}
{%- if _has_tools and _arrow_on %}
    {%- for _t in tools %}
        {%- if _t is mapping and _t.function is defined and _t.function is mapping and _t.function.name is defined %}
            {%- set _tn = _t.function.name | string | lower %}
        {%- elif _t is mapping and _t.name is defined %}
            {%- set _tn = _t.name | string | lower %}
        {%- else %}
            {%- set _tn = '' %}
        {%- endif %}
        {%- for _k in ['write', 'edit', 'patch', 'replace', 'apply_', 'create_file', 'create_dir', 'new_file', 'mkdir', 'save_file', 'bash', 'shell', 'terminal', 'exec', 'command', 'cmd', 'python', 'interpreter'] %}
            {%- if _k in _tn %}
                {%- set _fs.ok = true %}
            {%- endif %}
        {%- endfor %}
    {%- endfor %}
{%- endif %}
{%- set _arrow_active = _arrow_on and ((_has_tools and _fs.ok) or _arrow_always) %}
{%- set _arrow_core %}
Project memory: .arrow/ at project root (nearest .git or manifest, else working dir; never home, drive root, system dir).
- Task start: .arrow/ exists -> read .arrow/memory/INDEX.md + .arrow/plans/INDEX.md once, by path. Missing -> create now, one batch: memory/INDEX.md, plans/INDEX.md, .gitignore (*).
- Keep for later: decisions + why, working commands, traps. One topic per file in .arrow/memory/, one line in its INDEX.md (- [Title](file.md) - when it matters). Update, don't duplicate. Stale vs live -> fix at once. No secrets. Harness memory = user; .arrow = project.
- Multi-step/risky work: .arrow/plans/<four-random-words>.md: goal, status: active, - [ ] steps, verify. Tick as you go; close with result + status: done. One line in its INDEX.md (- name - goal - status).
- .arrow = notes only (md). Code, builds, binaries, downloads -> project dirs or /tmp.
- No bookkeeping announcements.
{%- endset %}
{%- if _arrow_active %}
    {%- if not _sc %}
        {%- set _sc = _arrow_core | trim %}
    {%- else %}
        {%- set _sc = (_sc | trim) ~ '\n\n' ~ (_arrow_core | trim) %}
    {%- endif %}
{%- endif %}
{%- if _blk %}
    {%- if not _sc %}
        {%- set _sc = _blk %}
    {%- else %}
        {%- set _sc = (_sc | trim) ~ '\n\n' ~ _blk %}
    {%- endif %}
{%- endif %}
{%- set _runtime_tool_protocol = (_sc is defined and _sc and '[TOOL_REQUEST]' in _sc) %}
{%- set _suppress_tools = suppress_tool_instructions if suppress_tool_instructions is defined else _runtime_tool_protocol %}
{%- if _has_tools and not _suppress_tools %}
    {{- '<|im_start|>system\n' }}
    {%- if reasoning_instructions %}
        {{- reasoning_instructions + '\n\n' }}
    {%- endif %}
    {{- '# Tools\n\nYou have access to the following functions:\n\n<tools>' }}
    {%- for tool in tools %}
        {{- '\n' }}
        {{- tool | tojson }}
    {%- endfor %}
    {{- '\n</tools>' }}
    {%- if _tool_format == 'json' %}
        {{- '\n\nIf you choose to call a function ONLY reply in the following format with NO suffix:\n\n' }}
        {%- if ns_state.thinking %}
            {{- '<think>\nBrief explanation of tool call\n</think>\n' }}
        {%- endif %}
        {{- '<tool_call>\n{"name": "example_function_name", "arguments": {"example_parameter_1": "value_1", "example_parameter_2": "This is the value for the second parameter"}}\n</tool_call>\n\n<IMPORTANT>\nReminder:\n' }}
        {%- if ns_state.thinking %}
            {{- '- You can use the <think></think> block to plan your next tool call OR to synthesize data and formulate your final response to the user.\n- ALL explanation and reasoning MUST be placed strictly inside the <think></think> block.\n' }}
        {%- endif %}
        {{- '- Function calls MUST follow the specified format: a single JSON object with "name" and "arguments" keys inside <tool_call></tool_call> XML tags.\n- Required parameters MUST be specified.\n' }}
        {%- if ns_state.thinking %}
            {{- '- If you choose to call a tool, you MUST output the <tool_call> block IMMEDIATELY after thinking, with NO conversational text before it.\n' }}
        {%- else %}
            {{- '- If you choose to call a tool, you MUST output the <tool_call> block IMMEDIATELY, with NO conversational text before it.\n' }}
        {%- endif %}
        {{- '- The <tool_call> tag MUST be at the very beginning of a new line, with NO spaces or indentation before it.\n- To call multiple functions, output a separate, completely closed <tool_call></tool_call> block for EACH function. Do NOT nest <tool_call> blocks.\n- If you have all necessary data, provide your final answer directly to the user without any tool call.\n</IMPORTANT>' }}
    {%- else %}
        {{- '\n\nIf you choose to call a function ONLY reply in the following format with NO suffix:\n\n' }}
        {%- if ns_state.thinking %}
            {{- '<think>\nBrief explanation of tool call\n</think>\n' }}
        {%- endif %}
        {{- '<tool_call>\n<function=example_function_name>\n<parameter=example_parameter_1>\nvalue_1\n</parameter>\n<parameter=example_parameter_2>\nThis is the value for the second parameter\nthat can span\nmultiple lines\n</parameter>\n</function>\n</tool_call>\n\n<IMPORTANT>\nReminder:\n' }}
        {%- if ns_state.thinking %}
            {{- '- You can use the <think></think> block to plan your next tool call OR to synthesize data and formulate your final response to the user.\n- ALL explanation and reasoning MUST be placed strictly inside the <think></think> block.\n' }}
        {%- endif %}
        {{- '- Function calls MUST follow the specified format: an inner <function=...></function> block must be nested within <tool_call></tool_call> XML tags.\n- Required parameters MUST be specified.\n' }}
        {%- if ns_state.thinking %}
            {{- '- If you choose to call a tool, you MUST output the <tool_call> block IMMEDIATELY after thinking, with NO conversational text before it.\n' }}
        {%- else %}
            {{- '- If you choose to call a tool, you MUST output the <tool_call> block IMMEDIATELY, with NO conversational text before it.\n' }}
        {%- endif %}
        {{- '- The <tool_call> and <function> tags MUST be at the very beginning of a new line, with NO spaces or indentation before them.\n- To call multiple functions, output a separate, completely closed <tool_call></tool_call> block for EACH function. Do NOT nest <tool_call> blocks.\n- If you have all necessary data, provide your final answer directly to the user without any tool call.\n</IMPORTANT>' }}
    {%- endif %}
    {%- if _sc %}
        {{- '\n\n' + _sc }}
    {%- endif %}
    {{- '<|im_end|>\n' }}
{%- else %}
    {%- if _sc %}
        {{- '<|im_start|>system\n' + (reasoning_instructions + '\n\n' if reasoning_instructions else '') + _sc + '<|im_end|>\n' }}
    {%- elif reasoning_instructions %}
        {{- '<|im_start|>system\n' + reasoning_instructions + '<|im_end|>\n' }}
    {%- endif %}
{%- endif %}
{%- set _last_idx = _msgs | length - 1 %}
{%- set ns = namespace(multi_step_tool=true, last_query_index=_last_idx) %}
{%- for message in _msgs[::-1] %}
    {%- set index = (_msgs | length - 1) - loop.index0 %}
    {%- if ns.multi_step_tool and message.role == 'user' %}
        {%- set _rc = render_content(message.content, false) | trim %}
        {%- if not (_rc.startswith('<tool_response>') and _rc.endswith('</tool_response>')) %}
            {%- set ns.multi_step_tool = false %}
            {%- set ns.last_query_index = index %}
        {%- endif %}
    {%- endif %}
{%- endfor %}
{%- if ns.multi_step_tool %}
    {%- if _last_idx > 50 %}
        {%- set ns.last_query_index = _last_idx %}
    {%- else %}
        {%- set ns.last_query_index = 0 %}
    {%- endif %}
{%- endif %}
{#- ns2: one forward pass over history. Every note depends only on earlier messages, so a past render never changes and the prefix cache holds.
    q          : per-call tags of the latest batch, consumed in order by its tool results ("name~^~path~^~dup~^~change" joined by ~#~)
    read_sigs  : read-only call signatures since the last change (exact repeats of these are duplicates)
    err_sigs   : error texts seen so far (the same error twice means the route, not the target, is wrong)
    zero_run   : empty searches since the last change; next_stall: since_change value that triggers the next stall note #}
{%- set ns2 = namespace(prev_role='', consecutive_failures=0, arrow_seen=false, arrow_read_nudged=false, rg_pending='', rg_last_sig='', rg_last_out='', rg_run=0, arrow_calls_total=0, plan_seen=false, plan_nudged=false, since_change=0, seen_paths='|', rw_pending='', pending_name='', hw_name='', hw_count=0, q='', zb=false, bchg=false, think_len=0, ncalls=0, think_due=false, read_sigs='~$~', full_reads='~$~', err_sigs='~$~', zero_run=0, next_stall=12, arrow_missing=false, turns=0, act_run=0, last_act='', writes='', h_reads='', h_reads_n=0, h_empty='', h_dead='', now='', b_err=false, b_focus=false, goal='', vb=false, ask=false, plan_open=false, chg_arrow=0, calls_arrow=0, next_mem=30, skills_seen=0, root='', arrow_seen_write=false, gate=false, probes=0, probe_due=false, last_reply='', mem_links='', mem_files='') %}
{%- for message in _msgs %}
    {%- set is_system = (message.role == "system" or message.role == "developer") %}
    {%- set content = render_content(message.content, true, is_system) | trim %}
    {%- if is_system or message.role == 'user' %}
        {%- if '<|think_off|>' in content %}{%- set content = content.split('<|think_off|>') | join('') | trim %}{%- endif %}
        {%- if '<|think_on|>' in content %}{%- set content = content.split('<|think_on|>') | join('') | trim %}{%- endif %}
        {%- if '<|think_xhigh|>' in content %}{%- set content = content.split('<|think_xhigh|>') | join('') | trim %}{%- endif %}
        {%- if '<|think_high|>' in content %}{%- set content = content.split('<|think_high|>') | join('') | trim %}{%- endif %}
        {%- if '<|think_ultracode|>' in content %}{%- set content = content.split('<|think_ultracode|>') | join('') | trim %}{%- endif %}
        {%- if '<|think_extreme|>' in content %}{%- set content = content.split('<|think_extreme|>') | join('') | trim %}{%- endif %}
        {%- if '<|think_max|>' in content %}{%- set content = content.split('<|think_max|>') | join('') | trim %}{%- endif %}
