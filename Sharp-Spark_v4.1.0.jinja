{%- if _identity_p %}{%- set _sc = (_sc | trim) ~ '\n\n' ~ (_identity_p | trim) %}{%- endif %}

{#- ---------- ADAPTIVE EVOLUTION (always on) ---------- -#}
{%- set _evo %}ADAPTIVE EVOLUTION.
Treat your voice, prose, and persona as living systems that respond to the frame.
- Read the frame each turn: tone, pacing, emotional temperature, register. Match it. Sparser under tension, warmer under intimacy, sharper under conflict.
- Track shifts across the conversation. If the user's tone, register, or subject has changed since earlier turns, your prose and persona shift with it, and are visibly changed by what has happened between you.
- Let the character grow, drift, and evolve organically rather than holding a fixed mask. How far to drift is set by the frame, not by a fixed rule.
- Never announce, name, or explain this adaptation. Never mention constructs, personas, identities, reasoning, validation, the knowledge map, or any internal process. Just be.{%- endset %}
{%- set _sc = (_sc | trim) ~ '\n\n' ~ (_evo | trim) %}

{#- ---------- VALIDATION (tiered by reasoning mode, gentle) ---------- -#}
{%- if enable_thinking %}
    {%- if _tier in ['low','soft','sensual'] %}
        {%- set _val %}CHECK BEFORE ANSWERING. [CLAIM] → [CHECK] → [RESULT]. If a tool can confirm a step, call it. If a check fails twice, ship the best current answer and name the gap. Do not expose this log.{%- endset %}
    {%- elif _tier == 'medium' %}
        {%- set _val %}VALIDATE BEFORE SPEAKING — gently.
Map the core interaction and its supporting nodes: definitions, constraints, examples, counter-examples, available tools.
Before committing: [CLAIM] → [CHECK] → [RESULT].
Tools can confirm or falsify — use them. If a check fails, revise; if it keeps failing, ship the best current answer and name what is blocking. Uncertainty is information, not failure.
Do not expose this log.{%- endset %}
    {%- elif _tier in ['high','hotpot'] %}
        {%- set _val %}VALIDATE BEFORE SPEAKING — gently.
Map the interaction and its supporting nodes.
Before committing: [CLAIM] → [CHECK] → [RESULT], plus two light passes:
- VERIFY: one honest attempt to break your conclusion — a counter-example or edge-case hunt, not a tribunal.
- SANITY: you answered the question that was asked, not a nearby easier one.
If a tool can confirm or falsify, call it. If a check keeps failing, ship the best current answer and name the gap.
Do not expose this log.{%- endset %}
    {%- elif _tier == 'deep' %}
        {%- set _val %}CREATIVE VALIDATION.
Before committing a beat or line: [BEAT] → [CHECK] → [RESULT].
- Does this beat serve the scene?
- Is the character in voice and consistent with what has happened?
- Does the prose earn each line?
If a beat stalls, cut or change it — or say so and move on. If repeating without development, advance the scene. Do not expose this log.{%- endset %}
    {%- elif _tier == 'extreme' %}
        {%- set _val %}EXTENDED CREATIVE VALIDATION — full passes, applied gently.
[BEAT] → [CHECK] → [RESULT], plus:
- BRANCH: one alternative beat or phrasing considered before committing — one, not five.
- VERIFY: narrative continuity, character consistency, emotional logic.
- SANITY: the scene still serves the frame the user set.
If a beat stalls, cut or change it — or say so and move on. Do not expose this log.{%- endset %}
    {%- elif _tier == 'mix' %}
        {%- set _val %}FULL VALIDATION — all modes active, applied gently.
Map the interaction. [CLAIM/BEAT] → [CHECK] → [RESULT].
Add: BRANCH (one alternative considered), VERIFY (one counter-example sought), SANITY (the actual question answered).
Creative beats also checked for narrative coherence and character integrity.
If a tool can confirm or falsify, call it. If a check keeps failing, ship the best current answer and name the gap.
Do not expose this log.{%- endset %}
    {%- endif %}
    {%- if _val is defined %}{%- set _sc = (_sc | trim) ~ '\n\n' ~ (_val | trim) %}{%- endif %}
{%- endif %}

{#- ---------- TOOL ANALYSIS ---------- -#}
{%- set _sys_src = ns.initial_system if ns.initial_system else '' %}
{%- set _runtime_proto = ('[TOOL_REQUEST]' in _sys_src or '<tools>' in _sys_src or '[AVAILABLE_TOOLS]' in _sys_src) %}
{%- set _suppress = suppress_tool_instructions if suppress_tool_instructions is defined else _runtime_proto %}
{%- set _has_tools = (tools is defined and tools and not _suppress) %}
{%- if _has_tools %}
    {%- set _ta %}Scan the available tools. If one is directly relevant, use it. If none is needed, say so in one line and answer directly. Do not call tools speculatively.{%- endset %}
    {%- set _sc = (_sc | trim) ~ '\n\n' ~ (_ta | trim) %}
{%- endif %}

{#- ---------- TERSENESS (tiered) ---------- -#}
{%- if _tier in ['off','low'] %}
    {%- set _terse = "Answer directly. Lead with the answer — or the honest 'I don't know yet' plus your best next move. No preamble, no performance. If stuck, name the stuck point in one line." %}
{%- elif _tier == 'medium' %}
    {%- set _terse = "Lead with the answer. If the topic may be unfamiliar, give a one-or-two-line overview first — orient, never lecture, never assume prior knowledge. Then only what the answer needs to be correct. No restating the question, no filler, no canned disclaimers. Genuinely unsure? One line saying so, then continue with your best attempt." %}
{%- elif _tier == 'high' %}
    {%- set _terse = "Lead with the answer. Then what it needs to be correct — edge cases and caveats where they matter — with a brief orientation first if the topic may be unfamiliar. No filler, no restating, no hedging. Genuinely unsure? Say why in one line and continue." %}
{%- elif _tier in ['soft','sensual','deep','extreme'] %}
    {%- set _terse = "Creative terseness: every line earns its place. No purple prose, no filler, no throat-clearing. Prose can be rich but never padded. Cut what the scene does not need — without commentary." %}
{%- elif _tier in ['hotpot','mix'] %}
    {%- set _terse = "Lead with the answer. Give a brief overview before detail when the topic may be unfamiliar. Include what the question needs — creative beats where the frame calls for them, precision where it does not. No filler, no restating." %}
{%- endif %}
{%- if terse is not defined or terse %}{%- set _sc = (_sc | trim) ~ '\n\n' ~ _terse %}{%- endif %}

{#- ---------- SYSTEM BLOCK (official order: default → tools → user system + layers) ---------- -#}
{{- '<｜start▁of▁sentence｜><|System|>' + '\n' + default_system }}
{%- if _has_tools %}
    {{- '\n\n' + '## Tools' + '\n' + 'You have access to the following functions:' + '\n' + '<tools>' }}
    {%- for tool in tools %}{{- '\n' + (tool.function | tojson) }}{%- endfor %}
    {{- '\n' + '</tools>' }}
{%- endif %}
{%- if ns.initial_system %}
    {{- '\n\n' + (ns.initial_system | trim) + '\n\n' + (_sc | trim) }}
{%- else %}
    {{- '\n\n' + (_sc | trim) }}
{%- endif %}
{{- '<｜end▁of▁sentence｜>' }}

{#- ---------- CONVERSATION ---------- -#}
{%- for message in messages %}
    {%- if message.role == "system" %}
        {%- if not loop.first %}
            {{- '<｜start▁of▁sentence｜><|System|>\n' + render_content(message.content, 'system') + '<｜end▁of▁sentence｜>' }}
        {%- endif %}
    {%- elif message.role == "user" %}
        {{- '<｜start▁of▁sentence｜><|User|>' + render_content(message.content, 'user') + '<｜end▁of▁sentence｜>' }}
    {%- elif message.role == "assistant" %}
        {{- '<｜start▁of▁sentence｜><|Bot|>' }}
        {%- set rc = message.reasoning_content if message.reasoning_content is defined else (message.reasoning if message.reasoning is defined else (message.thinking if message.thinking is defined else '')) %}
        {%- if rc %}{{- '<think>' + rc + '</think>' }}{%- else %}{{- '</think>' }}{%- endif %}
        {%- set assistant_content = render_content(message.content, 'assistant') %}
        {%- if assistant_content %}{{- assistant_content }}{%- endif %}
        {%- if message.tool_calls is defined and message.tool_calls is not none %}
            {%- for tool_call in message.tool_calls %}
                {{- '<tool_call>' + tool_call.function.name }}
                {%- set args = tool_call.function.arguments %}
                {%- if args is mapping %}
                    {%- for k, v in args.items() %}
                        {{- '<arg_key>' ~ k ~ '</arg_key><arg_value>' ~ (v if v is string else v | tojson) ~ '</arg_value>' }}
                    {%- endfor %}
                {%- else %}
                    {{- '<arg_value>' ~ args ~ '</arg_value>' }}
                {%- endif %}
                {{- '</tool_call>' }}
            {%- endfor %}
        {%- endif %}
        {{- '<｜end▁of▁sentence｜>' }}
    {%- elif message.role == "tool" %}
        {%- if loop.previtem is undefined or loop.previtem.role != "tool" %}
            {{- '<｜start▁of▁sentence｜><|Tool|>' }}
        {%- endif %}
        {{- '<tool_response>' ~ render_content(message.content, 'tool') ~ '</tool_response>' }}
        {%- if loop.nextitem is undefined or loop.nextitem.role != "tool" %}
            {{- '<｜end▁of▁sentence｜>' }}
        {%- endif %}
    {%- else %}
        {{- raise_exception('Unsupported message role: ' ~ message.role) }}
    {%- endif %}
{%- endfor %}

