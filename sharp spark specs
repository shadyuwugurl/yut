# modeling_spark.py — Custom MLX port of transformers-style Spark2_5
# with three runtime patches:
#   (a) Hadamard weight rotation applied to activations before q_k_v_proj,
#       gate_proj, up_proj (matches rotated weights baked into safetensors)
#   (b) TurboQuant KV-cache rotation for full-attention layers: keys stored
#       in rotated frame, queries rotated to match; attention scores unchanged
#   (c) YaRN RoPE scaling for full-attention layers

import math
from dataclasses import dataclass, field
from typing import Any, Dict, List, Optional

import mlx.core as mx
import mlx.nn as nn

from mlx_lm.models.base import BaseModelArgs, create_attention_mask, scaled_dot_product_attention
from mlx_lm.models.cache import KVCache, RotatingKVCache
from mlx_lm.models.rope_utils import YarnRoPE


# ── Hadamard rotation matrix (64×64 block) ──────────────────────────────
# hidden_size = 2560 = 40 × 64; head_dim = 256 = 4 × 64
BLOCK = 64


def _build_hadamard(d: int) -> mx.array:
    """Build a d×d Hadamard matrix (d must be a power of two)."""
    H = mx.array([[1.0]])
    while H.shape[0] < d:
        H_top = mx.concatenate([H, H], axis=1)
        H_bottom = mx.concatenate([H, -H], axis=1)
        H = mx.concatenate([H_top, H_bottom], axis=0)
    return H / mx.sqrt(mx.array(d, dtype=mx.float32))


_H = _build_hadamard(BLOCK)  # [64, 64]


def rotate_last_dim(x: mx.array, H: mx.array) -> mx.array:
    """Apply blockwise Hadamard rotation to the last dimension of x.

    Reshapes [..., in_features] → [..., n_blocks, BLOCK], applies
    x @ Hᵀ per block, then reshapes back.  The rotation is orthogonal so
    it preserves norms and (when applied to both Q and K) leaves attention
    scores unchanged.
    """
    orig_dtype = x.dtype
    *leading, in_f = x.shape
    n_blocks = in_f // BLOCK
    x = x.reshape(*leading, n_blocks, BLOCK)
    x_rot = mx.matmul(x, H.T)
    return x_rot.reshape(*leading, in_f).astype(orig_dtype)


# ── ModelArgs ────────────────────────────────────────────────────────────

@dataclass
class ModelArgs(BaseModelArgs):
    model_type: str = "spark2_5"
    hidden_size: int = 2560
    intermediate_size: int = 10240
    num_hidden_layers: int = 36
    num_attention_heads: int = 16
    num_key_value_heads: int = 4
    head_dim: int = 256
    vocab_size: int = 131072
    sliding_window: int = 512
    rope_parameters: Dict[str, Dict[str, Any]] = field(default_factory=dict)
    layer_types: Optional[List[str]] = None
    rms_norm_eps: float = 1e-6
    max_position_embeddings: int = 1048576
    attention_bias: bool = False
    mlp_bias: bool = False
    hidden_act: str = "gelu"
    gate_attn_act_mode: str = "sigmoid"
    headwise_attn_output_gate: bool = True
    tie_word_embeddings: bool = True

    # Patch flags
    use_weight_rotation: bool = True
    use_kv_cache_rotation: bool = True
    use_yarn_rope: bool = True
    yarn_factor: float = 4.0
    yarn_original_max_position_embeddings: int = 262144

    def __post_init__(self):
        if self.layer_types is None:
            pattern = ["sliding_attention"] * 3 + ["full_attention"]
            self.layer_types = [
                pattern[i % len(pattern)] for i in range(self.num_hidden_layers)
            ]
        if len(self.layer_types) != self.num_hidden_layers:
            raise ValueError(
                f"layer_types length must match num_hidden_layers: "
                f"{len(self.layer_types)} != {self.num_hidden_layers}"
            )
        unsupported = set(self.layer_types) - {"sliding_attention", "full_attention"}
        if unsupported:
            raise ValueError(f"Unsupported layer types: {sorted(unsupported)}")
        missing_rope = set(self.layer_types) - set(self.rope_parameters)
        if missing_rope:
            raise ValueError(
                f"Missing RoPE parameters for layer types: {sorted(missing_rope)}"
            )
        if self.num_attention_heads % self.num_key_value_heads:
            raise ValueError(
                "num_attention_heads must be divisible by num_key_value_heads"
            )
        if self.num_attention_heads * self.head_dim <= 0:
            raise ValueError("num_attention_heads * head_dim must be positive")
        for layer_type in set(self.layer_types):
            factor = float(
                self.rope_parameters[layer_type].get("partial_rotary_factor", 1.0)
            )
            dims = int(self.head_dim * factor)
            if dims <= 0 or dims > self.head_dim or dims % 2:
                raise ValueError(
                    f"Invalid rotary dimension {dims} for {layer_type} "
                    f"with head_dim={self.head_dim}"
                )
        if self.hidden_act != "gelu":
            raise ValueError(f"Spark2_5 requires GELU, got {self.hidden_act!r}")
        if not self.headwise_attn_output_gate:
            raise ValueError("Spark2_5 requires head-wise attention output gates")
        if self.gate_attn_act_mode != "sigmoid":
            raise ValueError(
                f"Spark2_5 requires sigmoid attention gates, got "
                f"{self.gate_attn_act_mode!r}"
            )


# ── Attention ────────────────────────────────────────────────────────────

class Attention(nn.Module):
    def __init__(self, args: ModelArgs, layer_idx: int):
        super().__init__()
        self.n_heads = args.num_attention_heads
        self.n_kv_heads = args.num_key_value_heads
        self.head_dim = args.head_dim
        self.scale = self.head_dim ** -0.5
        self.layer_idx = layer_idx

        layer_type = args.layer_types[layer_idx]
        self.is_sliding = layer_type == "sliding_attention"
        self.is_full = not self.is_sliding

        self._use_weight_rotation = args.use_weight_rotation
        self._use_kv_cache_rotation = args.use_kv_cache_rotation

        q_size = self.n_heads * self.head_dim
        kv_size = self.n_kv_heads * self.head_dim
        self.q_size = q_size
        self.kv_size = kv_size

        self.q_k_v_proj = nn.Linear(
            args.hidden_size, q_size + 2 * kv_size, bias=args.attention_bias
        )
        self.g_proj = nn.Linear(
            args.hidden_size, self.n_heads, bias=args.attention_bias
        )
        self.out_proj = nn.Linear(
            q_size, args.hidden_size, bias=args.attention_bias
        )

        # Patch (c): YaRN RoPE for full-attention layers; standard RoPE for sliding
        rope_params = args.rope_parameters[layer_type]
        base = float(rope_params.get("rope_theta", 10000.0))
        prf = float(rope_params.get("partial_rotary_factor", 1.0))
        if self.is_full and args.use_yarn_rope:
            self.rope = YarnRoPE(
                dims=int(self.head_dim * prf),
                traditional=False,
                max_position_embeddings=args.max_position_embeddings,
                base=base,
                scaling_factor=args.yarn_factor,
                original_max_position_embeddings=args.yarn_original_max_position_embeddings,
            )
        else:
            dims = int(self.head_dim * prf)
            self.rope = nn.RoPE(dims, traditional=False, base=base)

    def __call__(self, x, mask=None, cache=None):
        batch_size, sequence_length, _ = x.shape

        # Patch (a): Hadamard weight rotation on activations before q_k_v_proj.
        # The weights were rotated as W @ Hᵀ on their input dimension, so we
        # apply H to the hidden states before the projection to restore
        # equivalence: (W @ Hᵀ) (H x) = W x.
        # ALL layers (sliding + full) had their weights rotated, so apply to all.
        # Save the original x for g_proj, which was NOT rotated.
        orig_x = x
        if self._use_weight_rotation:
            x = rotate_last_dim(x, _H)

        qkv = self.q_k_v_proj(x)
        queries, keys, values = mx.split(
            qkv, [self.q_size, self.q_size + self.kv_size], axis=-1
        )

        queries = queries.reshape(
            batch_size, sequence_length, self.n_heads, self.head_dim
        ).transpose(0, 2, 1, 3)
        keys = keys.reshape(
            batch_size, sequence_length, self.n_kv_heads, self.head_dim
        ).transpose(0, 2, 1, 3)
        values = values.reshape(
            batch_size, sequence_length, self.n_kv_heads, self.head_dim
        ).transpose(0, 2, 1, 3)

        queries = mx.contiguous(queries)
        keys = mx.contiguous(keys)
        values = mx.contiguous(values)

        # RoPE (applied before KV-cache rotation so both Q and K are
        # position-encoded before being moved into the rotated frame)
        offset = cache.offset if cache is not None else 0
        queries = self.rope(queries, offset=offset)
        keys = self.rope(keys, offset=offset)

        # Patch (b): KV-cache rotation.  Store keys in the Hadamard-rotated
        # frame and rotate queries to match.  Since H is orthogonal,
        # (H q)ᵀ (H k) = qᵀ k, so attention scores are identical to the
        # unrotated computation.  Sliding-window layers skip this.
        if self.is_full and self._use_kv_cache_rotation:
            queries = rotate_last_dim(queries, _H)
            keys = rotate_last_dim(keys, _H)

        if cache is not None:
            keys, values = cache.update_and_fetch(keys, values)

        output = scaled_dot_product_attention(
            queries, keys, values, cache=cache, scale=self.scale, mask=mask,
        )
        output = mx.contiguous(output.transpose(0, 2, 1, 3))

        gate = mx.sigmoid(self.g_proj(orig_x).astype(mx.float32)).astype(output.dtype)
        output = output * gate[..., None]

        return self.out_proj(output.reshape(batch_size, sequence_length, -1))


# ── MLP ──────────────────────────────────────────────────────────────────

class MLP(nn.Module):
    def __init__(self, args: ModelArgs):
        super().__init__()
        self.gate_proj = nn.Linear(
            args.hidden_size, args.intermediate_size, bias=args.mlp_bias
        )
        self.up_proj = nn.Linear(
            args.hidden_size, args.intermediate_size, bias=args.mlp_bias
        )
        self.down_proj = nn.Linear(
            args.intermediate_size, args.hidden_size, bias=args.mlp_bias
        )
        self._use_weight_rotation = args.use_weight_rotation

    def __call__(self, x: mx.array) -> mx.array:
        # Patch (a): Hadamard weight rotation on activations before gate_proj
        # and up_proj.  down_proj is intentionally NOT rotated: its input is
        # the MLP intermediate (already in the correct basis since gate/up
        # produce the same output as unrotated weights), and its output feeds
        # the residual stream which must not be rotated.
        if self._use_weight_rotation:
            x = rotate_last_dim(x, _H)
        return self.down_proj(nn.gelu(self.gate_proj(x)) * self.up_proj(x))


# ── Transformer block ────────────────────────────────────────────────────

class TransformerBlock(nn.Module):
    def __init__(self, args: ModelArgs, layer_idx: int):
        super().__init__()
        self.self_attn = Attention(args, layer_idx)
        self.mlp = MLP(args)
        self.input_layernorm = nn.RMSNorm(args.hidden_size, eps=args.rms_norm_eps)
        self.post_attention_layernorm = nn.RMSNorm(
            args.hidden_size, eps=args.rms_norm_eps
        )

    @property
    def is_sliding(self) -> bool:
        return self.self_attn.is_sliding

    def __call__(self, x, mask=None, cache=None):
        attention_output = self.self_attn(self.input_layernorm(x), mask, cache)
        hidden_states = x + attention_output
        mlp_output = self.mlp(self.post_attention_layernorm(hidden_states))
        return hidden_states + mlp_output


# ── Model ────────────────────────────────────────────────────────────────

class Spark2_5Model(nn.Module):
    def __init__(self, args: ModelArgs):
        super().__init__()
        self.args = args
        self.embedding = nn.Embedding(args.vocab_size, args.hidden_size)
        self.layers = [
            TransformerBlock(args, layer_idx)
            for layer_idx in range(args.num_hidden_layers)
        ]
        self.norm = nn.RMSNorm(args.hidden_size, eps=args.rms_norm_eps)

        self._first_full = next(
            (idx for idx, lt in enumerate(args.layer_types) if lt == "full_attention"),
            None,
        )
        self._first_sliding = next(
            (idx for idx, lt in enumerate(args.layer_types) if lt == "sliding_attention"),
            None,
        )

    def __call__(self, inputs, cache=None, input_embeddings=None):
        hidden_states = (
            input_embeddings if input_embeddings is not None else self.embedding(inputs)
        )

        if cache is None:
            cache = [None] * len(self.layers)

        full_mask = None
        if self._first_full is not None:
            full_mask = create_attention_mask(hidden_states, cache[self._first_full])
        sliding_mask = None
        if self._first_sliding is not None:
            sliding_mask = create_attention_mask(
                hidden_states,
                cache[self._first_sliding],
                window_size=self.args.sliding_window,
            )

        for layer, layer_cache in zip(self.layers, cache):
            mask = sliding_mask if layer.is_sliding else full_mask
            hidden_states = layer(hidden_states, mask, layer_cache)

        return self.norm(hidden_states)


class Model(nn.Module):
    def __init__(self, args: ModelArgs):
        super().__init__()
        self.args = args
        self.model_type = args.model_type
        self.model = Spark2_5Model(args)
        if not args.tie_word_embeddings:
            self.lm_head = nn.Linear(args.hidden_size, args.vocab_size, bias=False)

    def __call__(self, inputs, cache=None, input_embeddings=None):
        hidden_states = self.model(inputs, cache, input_embeddings)
        if self.args.tie_word_embeddings:
            return self.model.embedding.as_linear(hidden_states)
        return self.lm_head(hidden_states)

    @property
    def layers(self):
        return self.model.layers

    def make_cache(self):
        return [
            (
                RotatingKVCache(max_size=self.args.sliding_window, keep=0)
                if layer.is_sliding
                else KVCache()
            )
            for layer in self.model.layers
        ]

    @property
    def quant_predicate(self):
        # The head-gate is a tiny per-head gating projection; keep it at
        # source precision to preserve sigmoid gate values.
        def predicate(path, _):
            return not path.endswith("self_attn.g_proj")

        return predicate

    def sanitize(self, weights):
        # Some MLX conversions rename the embedding to embed_tokens while the
        # Hugging Face checkpoint ships it as model.embedding.weight.
        if (
            "model.embed_tokens.weight" in weights
            and "model.embedding.weight" not in weights
        ):
            weights["model.embedding.weight"] = weights.pop("model.embed_tokens.weight")
        if self.args.tie_word_embeddings:
            weights.pop("lm_head.weight", None)
        # Drop the serialized RoPE inverse-frequency buffer some conversions ship.
        return {
            name: value
            for name, value in weights.items()
            if "rotary_emb.inv_freq" not in name
        }


__all__ = ["ModelArgs", "Model", "Spark2_5Model"]
