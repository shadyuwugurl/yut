                "text": "Read file /Users/charlie/Documents/Default Project/Spark-2.6-4B-AXQ-rotated/modeling_spark.py, lines 1-396\n1: # modeling_spark.py — Custom MLX port of transformers-style Spark2_5\n2: # with three runtime patches:\n3: #   (a) Hadamard weight rotation applied to activations before q_k_v_proj,\n4: #       gate_proj, up_proj (matches rotated weights baked into safetensors)\n5: #   (b) TurboQuant KV-cache rotation for full-attention layers: keys stored\n6: #       in rotated frame, queries rotated to match; attention scores unchanged\n7: #   (c) YaRN RoPE scaling for full-attention layers\n8: \n9: import math\n10: from dataclasses import dataclass, field\n11: from typing import Any, Dict, List, Optional\n12: \n13: import mlx.core as mx\n14: import mlx.nn as nn\n15: \n16: from mlx_lm.models.base import BaseModelArgs, create_attention_mask, scaled_dot_product_attention\n17: from mlx_lm.models.cache import KVCache, RotatingKVCache\n18: from mlx_lm.models.rope_utils import YarnRoPE\n19: \n20: \n21: # ── Hadamard rotation matrix (64×64 block) ──────────────────────────────\n22: # hidden_size = 2560 = 40 × 64; head_dim = 256 = 4 × 64\n23: BLOCK = 64\n24: \n25: \n26: def _build_hadamard(d: int) -> mx.array:\n27:     \"\"\"Build a d×d Hadamard matrix (d must be a power of two).\"\"\"\n28:     H = mx.array([[1.0]])\n29:     while H.shape[0] < d:\n30:         H_top = mx.concatenate([H, H], axis=1)\n31:         H_bottom = mx.concatenate([H, -H], axis=1)\n32:         H = mx.concatenate([H_top, H_bottom], axis=0)\n33:     return H / mx.sqrt(mx.array(d, dtype=mx.float32))\n34: \n35: \n36: _H = _build_hadamard(BLOCK)  # [64, 64]\n37: \n38: \n39: def rotate_last_dim(x: mx.array, H: mx.array) -> mx.array:\n40:     \"\"\"Apply blockwise Hadamard rotation to the last dimension of x.\n41: \n42:     Reshapes [..., in_features] → [..., n_blocks, BLOCK], applies\n43:     x @ Hᵀ per block, then reshapes back.  The rotation is orthogonal so\n44:     it preserves norms and (when applied to both Q and K) leaves attention\n45:     scores unchanged.\n46:     \"\"\"\n47:     orig_dtype = x.dtype\n48:     *leading, in_f = x.shape\n49:     n_blocks = in_f // BLOCK\n50:     x = x.reshape(*leading, n_blocks, BLOCK)\n51:     x_rot = mx.matmul(x, H.T)\n52:     return x_rot.reshape(*leading, in_f).astype(orig_dtype)\n53: \n54: \n55: # ── ModelArgs ────────────────────────────────────────────────────────────\n56: \n57: @dataclass\n58: class ModelArgs(BaseModelArgs):\n59:     model_type: str = \"spark2_5\"\n60:     hidden_size: int = 2560\n61:     intermediate_size: int = 10240\n62:     num_hidden_layers: int = 36\n63:     num_attention_heads: int = 16\n64:     num_key_value_heads: int = 4\n65:     head_dim: int = 256\n66:     vocab_size: int = 131072\n67:     sliding_window: int = 512\n68:     rope_parameters: Dict[str, Dict[str, Any]] = field(default_factory=dict)\n69:     layer_types: Optional[List[str]] = None\n70:     rms_norm_eps: float = 1e-6\n71:     max_position_embeddings: int = 1048576\n72:     attention_bias: bool = False\n73:     mlp_bias: bool = False\n74:     hidden_act: str = \"gelu\"\n75:     gate_attn_act_mode: str = \"sigmoid\"\n76:     headwise_attn_output_gate: bool = True\n77:     tie_word_embeddings: bool = True\n78: \n79:     # Patch flags\n80:     use_weight_rotation: bool = True\n81:     use_kv_cache_rotation: bool = True\n82:     use_yarn_rope: bool = True\n83:     yarn_factor: float = 4.0\n84:     yarn_original_max_position_embeddings: int = 262144\n85: \n86:     def __post_init__(self):\n87:         if self.layer_types is None:\n88:             pattern = [\"sliding_attention\"] * 3 + [\"full_attention\"]\n89:             self.layer_types = [\n90:                 pattern[i % len(pattern)] for i in range(self.num_hidden_layers)\n91:             ]\n92:         if len(self.layer_types) != self.num_hidden_layers:\n93:             raise ValueError(\n94:                 f\"layer_types length must match num_hidden_layers: \"\n95:                 f\"{len(self.layer_types)} != {self.num_hidden_layers}\"\n96:             )\n97:         unsupported = set(self.layer_types) - {\"sliding_attention\", \"full_attention\"}\n98:         if unsupported:\n99:             raise ValueError(f\"Unsupported layer types: {sorted(unsupported)}\")\n100:         missing_rope = set(self.layer_types) - set(self.rope_parameters)\n101:         if missing_rope:\n102:             raise ValueError(\n103:                 f\"Missing RoPE parameters for layer types: {sorted(missing_rope)}\"\n104:             )\n105:         if self.num_attention_heads % self.num_key_value_heads:\n106:             raise ValueError(\n107:                 \"num_attention_heads must be divisible by num_key_value_heads\"\n108:             )\n109:         if self.num_attention_heads * self.head_dim <= 0:\n110:             raise ValueError(\"num_attention_heads * head_dim must be positive\")\n111:         for layer_type in set(self.layer_types):\n112:             factor = float(\n113:                 self.rope_parameters[layer_type].get(\"partial_rotary_factor\", 1.0)\n114:             )\n115:             dims = int(self.head_dim * factor)\n116:             if dims <= 0 or dims > self.head_dim or dims % 2:\n117:                 raise ValueError(\n118:                     f\"Invalid rotary dimension {dims} for {layer_type} \"\n119:                     f\"with head_dim={self.head_dim}\"\n120:                 )\n121:         if self.hidden_act != \"gelu\":\n122:             raise ValueError(f\"Spark2_5 requires GELU, got {self.hidden_act!r}\")\n123:         if not self.headwise_attn_output_gate:\n124:             raise ValueError(\"Spark2_5 requires head-wise attention output gates\")\n125:         if self.gate_attn_act_mode != \"sigmoid\":\n126:             raise ValueError(\n127:                 f\"Spark2_5 requires sigmoid attention gates, got \"\n128:                 f\"{self.gate_attn_act_mode!r}\"\n129:             )\n130: \n131: \n132: