    {%- elif reasoning_instructions %}
        {{- '<｜start▁of▁sentence｜><|System|>\n' + reasoning_instructions + '<｜end▁of▁sentence｜>\n' }}
    {%- endif %}
{%- endif %}

{%- set ns = namespace(found_query=false, last_query_index=0) %}
{%- for message in _msgs[::-1] %}
