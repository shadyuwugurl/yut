19:                 \"identity\": identity,\n120:                 \"reasoning_effort\": effort,\n121:             })\n122:     if limit is not None:\n123:         jobs = jobs[:limit]\n124:     return jobs\n125: \n126: def pick_device():\n127:     import torch\n128:     if torch.backends.mps.is_available():\n129:         return \"mps\"\n130:     if torch.cuda.is_available():\n131:         return \"cuda\"\n132:     return \"cpu\"\n133: \n134: def load_model(model_path: Path, device: str):\n135:     import torch\n136:     from transformers import AutoModelForCausalLM, AutoTokenizer\n137: \n138:     print(f\"loading tokenizer from {model_path}\")\n139:     tok = AutoTokenizer.from_pretrained(str(model_path), trust_remote_code=True)\n140:     print(f\"loading model on {device} …\")\n141:     dtype = torch.float16 if device in (\"mps\", \"cuda\") else torch.float32\n142:     model = AutoModelForCausalLM.from_pretrained(\n143:         str(model_path),\n144:         torch_dtype=dtype,\n145:         trust_remote_code=True,\n146:         low_cpu_mem_usage=True,\n147:     )\n148:     model.to(device)\n149:     model.eval()\n150:     return tok, model\n151: \n152: def generate(tok, model, device, rendered: str, max_new: int):\n153:     import torch\n154:     inputs = tok(rendered, return_tensors=\"pt\")\n155:     inputs = {k: v.to(device) for k, v in inputs.items()}\n156:     with torch.no_grad():\n157:         out = model.generate(\n158:             **inputs,\n159:             max_new_tokens=max_new,\n160:             do_sample=True,\n161:             temperature=0.7,\n162:             top_p=0.9,\n163:             top_k=50,\n164:             repetition_penalty=1.05,\n165:             pad_token_id=tok.eos_token_id if tok.eos_token_id is not None else tok.pad_token_id,\n166:         )\n167:     # only new tokens\n168:     gen = out[0][inputs[\"input_ids\"].shape[-1]:]\n169:     return tok.decode(gen, skip_special_tokens=False)\n170: \n171: def frame_label(job):\n172:     parts =