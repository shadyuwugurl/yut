                            {%- set _trimmed_args = tc_args_raw | trim %}
                            {%- if _trimmed_args | length > 0 %}
                                {%- if _trimmed_args | first == '{' and _trimmed_args | last == '}' %}
                                    {%- set _args = _trimmed_args %}
                                {%- else %}
                                    {%- set _args = tc_args_raw | tojson %}
                                {%- endif %}
                            {%- endif %}
                        {%- else %}
                            {%- set _args = tc_args_raw | tojson %}
                        {%- endif %}
                    {%- endif %}
                    {{- '<tool_call>\n{"name": ' }}{{- tc_name | tojson }}{{- ', "arguments": ' }}{{- _args }}{{- '}\n</tool_call>' }}
                {%- else %}
                    {%- if loop.first %}
