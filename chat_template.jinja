         print(f\"[{i}/{len(jobs)}] {job['prompt_id']} · {label}\")\n215:         try:\n216:             rendered = render_prompt(\n217:                 tmpl,\n218:                 job[\"prompt\"],\n219:                 job[\"construct\"],\n220:                 job[\"persona\"],\n221:                 job[\"identity\"],\n222:                 job[\"reasoning_effort\"],\n223:             )\n224:         except Exception as e:\n225:             print(f\"  RENDER FAIL: {e}\")\n226:             results.append({**job, \"error\": f\"render: {e}\", \"output\": None, \"rendered_tail\": None})\n227:             continue\n228: \n229:         # cheap structural checks\n230:         has_frame = \"FRAME CARD\" in rendered\n231:         has_forced_coder = \"CODER MODE (forced)\" in rendered\n232:         has_assistant = \"helpful assistant\" in rendered.lower()\n233: \n234:         output = None\n235:         gen_s = None\n236:         if not args.dry_run:\n237:             try:\n238:                 t1 = time.time()\n239:                 output = generate(tok, model, device, rendered, args.max_new)\n240:                 gen_s = round(time.time() - t1, 2)\n241:             except Exception as e:\n242:                 print(f\"  GEN FAIL: {e}\")\n243:                 results.append({\n244:                     **job,\n245:                     \"error\": f\"gen: {e}\",\n246:                     \"output\": None,\n247:                     \"has_frame_card\": has_frame,\n248:                     \"has_forced_coder\": has_forced_coder,\n249:                     \"has_helpful_assistant\": has_assistant,\n250:                     \"rendered_tail\": rendered[-400:],\n251:                 })\n252:                 continue\n253: \n254:         row = {\n255:             **job,\n256:             \"error\": None,\n257:             \"has_frame_card\": has_frame,\n258:             \"has_forced_coder\": has_forced_coder,\n259:             \"has_helpful_assistant\": has_assistant,\n260:             