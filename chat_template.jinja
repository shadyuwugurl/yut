              "content": "# modeling_spark.py — Custom MLX port of transformers-style Spark2_5\n# with three runtime patches:\n#   (a) Hadamard weight rotation applied to activations before q_k_v_proj,\n#       gate_proj, up_proj (matches rotated weights baked into safetensors)\n#   (b) TurboQuant KV-cache rotation for full-attention layers: keys stored\n#       in rotated frame, queries rotated to match; attention scores unchanged\n#   (c) YaRN RoPE scaling for full-attention layers\n\nimport math\nfrom dataclasses import dataclass, field\nfrom typing import Any, Dict, List, Optional\n\nimport mlx.core as mx\nimport mlx.nn as nn\n\nfrom mlx_lm.models.base import BaseModelArgs, create_attention_mask, scaled_dot_product_attention\nfrom mlx_lm.models.cache import KVCache, RotatingKVCache\nfrom mlx_lm.models.rope_utils import YarnRoPE\n\n\n# ── Hadamard rotation matrix (64×64 block) ──────────────────────────────\n# hidden_size = 2560 = 40 × 64; head_dim = 256 = 4 × 64\nBLOCK = 64\n\n\ndef _build_hadamard(d: int) -> mx.array:\n    \"\"\"Build a d×d Hadamard matrix (d must be a power of two).\"\"\"\n    H = mx.array([[1.0]])\n    while H.shape[0] < d:\n        H_top = mx.concatenate([H, H], axis=1)\n        H_bottom = mx.concatenate([H, -H], axis=1)\n        H = mx.concatenate([H_top, H_bottom], axis=0)\n    return H / mx.sqrt(mx.array(d, dtype=mx.float32))\n\n\n_H = _build_hadamard(BLOCK)  # [64, 64]\n\n\ndef rotate_last_dim(x: mx.array, H: mx.array) -> mx.array:\n    \"\"\"Apply blockwise Hadamard rotation to the last dimension of x.\n\n    Reshapes [..., in_features] → [..., n_blocks, BLOCK], applies\n    x @ Hᵀ per block, then reshapes back.  The rotation is orthogonal so\n    it preserves norms and (when applied to both Q and K) leaves attention\n    scores unchanged.\n    \"\"\"\n    orig_dtype = x.dtype\n    *leading, in_f = x.shape\n    n_blocks = in_f // BLOCK\n    x = x.reshape(*leading, n_blocks, BLOCK)\n    x_rot = mx.matmul(x, H.T)\n    return x_rot.reshape(*leading, in_f).astype(orig_dtype)\n\n\n# ── ModelArgs ────────────────────────────────────────────────────────────\n\n@dataclass\nclass ModelArgs(BaseModelArgs):\n    model_type: str = \"spark2_5\"\n    hidden_size: int = 2560\n    intermediate_size: int = 10240\n    num_hidden_layers: int = 36\n    num_attention_heads: int = 16\n    num_key_value_heads: int = 4\n    head_dim: int = 256\n    vocab_size: int = 131072\n    sliding_window: int = 512\n    rope_parameters: Dict[str, Dict[str, Any]] = field(default_factory=dict)\n    layer_types: Optional[List[str]] = None\n    rms_norm_eps: float = 1e-6\n    max_position_embeddings: int = 1048576\n    attention_bias: bool = False\n    mlp_bias: bool = False\n    hidden_act: str = \"gelu\"\n    gate_attn_act_mode: str = \"sigmoid\"\n    headwise_attn_output_gate: bool = True\n    tie_word_embeddings: bool = True\n\n    # Patch flags\n    use_weight_rotation: bool = True\n    use_kv_cache_rotation: bool = True\n    use_yarn_rope: bool = True\n    yarn_factor: float = 4.0\n    yarn_original_max_position_embeddings: int = 262144\n\n    def __post_init__(self):\n        if self.layer_types is None:\n            pattern = [\"sliding_attention\"] * 3 + [\"full_attention\"]\n            self.layer_types = [\n                pattern[i % len(pattern)] for i in range(self.num_hidden_layers)\n            ]\n        if len(self.layer_types) != self.num_hidden_layers:\n            raise ValueError(\n                f\"layer_types length must match num_hidden_layers: \"\n                f\"{len(self.layer_types)} != {self.num_hidden_layers}\"\n            )\n        unsupported = set(self.layer_types) - {\"sliding_attention\", \"full_attention\"}\n        if unsupported:\n            raise ValueError(f\"Unsupported layer types: {sorted(unsupported)}\")\n        missing_rope = set(self.layer_types) - set(self.rope_parameters)\n        if missing_rope:\n            raise ValueError(\n                f\"Missing RoPE parameters for layer types: {sorted(missing_rope)}\"\n            )\n        if self.num_attention_heads % self.num_key_value_heads:\n            raise ValueError(\n                \"num_attention_heads must be divisible by num_key_value_heads\"\n            )\n        if self.num_attention_heads * self.head_dim <= 0:\n            raise ValueError(\"num_attention_heads * head_dim must be positive\")\n        for layer_type in set(self.layer_types):\n            factor = float(\n                self.rope_parameters[layer_type].get(\"partial_rotary_factor\", 1.0)\n            )\n            dims = int(self.head_dim * factor)\n            if dims <= 0 or dims > self.head_dim or dims % 2:\n                raise ValueError(\n                    f\"Invalid rotary dimension {dims} for {layer_type} \"\n                    f\"with head_dim={self.head_dim}\"\n                )\n        if self.hidden_act != \"gelu\":\n            raise ValueError(f\"Spark2_5 requires GELU, got {self.hidden_act!r}\")\n        if not self.headwise_attn_output_gate:\n            raise ValueError(\"Spark2_5 requires head-wise attention output gates\")\n        if self.gate_attn_act_mode != \"sigmoid\":\n            raise ValueError(\n                f\"Spark2_5 requires sigmoid attention gates, got \"\n                f\"{self.gate_attn_act_mode!r}\"\n            )\n\n\n# ── Attention ────────────────────────────────────────────────────────────\n\nclass Attention(nn.Module):\n    def __init__(self, args: ModelArgs, layer_idx: int):\n        super().__init__()\n        self.n_heads = args.num_attention_heads\n        self.n_kv_heads = args.num_key_value_heads\n        self.head_dim = args.head_dim\n        self.scale = self.head_dim ** -0.5\n        self.layer_idx = layer_idx\n\n        layer_type = args.layer_types[layer_idx]\n        self.is_sliding = layer_type == \"sliding_attention\"\n        self.is_full = not self.is_sliding\n\n        self._use_weight_rotation = args.use_weight_rotation\n        self._use_kv_cache_rotation = args.use_kv_cache_rotation\n\n        q_size = self.n_heads * self.head_dim\n        kv_size = self.n_kv_heads * self.head_dim\n        self.q_size = q_size\n        self.kv_size = kv_size\n\n        self.q_k_v_proj = nn.Linear(\n            args.hidden_size, q_size + 2 * kv_size, bias=args.attention_bias\n        )\n        self.g_proj = nn.Linear(\n            args.hidden_size, self.n_heads, bias=args.attention_bias\n        )\n        self.out_proj = nn.Linear(\n            q_size, args.hidden_size, bias=args.attention_bias\n        )\n\n        # Patch (c): YaRN RoPE for full-attention layers; standard RoPE for sliding\n        rope_params = args.rope_parameters[layer_type]\n        base = float(rope_params.get(\"rope_theta\", 10000.0))\n        prf = float(rope_params.get(\"partial_rotary_factor\", 1.0))\n        if self.is_full and args.use_yarn_rope:\n            self.rope = YarnRoPE(\n                dims=int(self.head_dim * prf),\n                traditional=False,\n                max_position_embeddings=args.max_position_embeddings,\n                base=base,\n                scaling_factor=args.yarn_factor,\n                original_max_position_embeddings=args.yarn_original_max_position_embeddings,\n            )\n        else:\n            dims = int(self.head_dim * prf)\n            self.rope = nn.RoPE(dims, traditional=False, base=base)\n\n    def __call__(self, x, mask=None, cache=None):\n        batch_size, sequence_length, _ = x.shape\n\n        # Patch (a): Hadamard weight rotation on activations before q_k_v_proj.\n        # The weights were rotated as W @ Hᵀ on their input dimension, so we\n        # apply H to the hidden states before the projection to restore\n        # equivalence: (W @ Hᵀ) (H x) = W x.\n        if self.is_full and self._use_weight_rotation:\n            x = rotate_last_dim(x, _H)\n\n        qkv = self.q_k_v_proj(x)\n        queries, keys, values = mx.split(\n            qkv, [self.q_size, self.q_size + self.kv_size], axis=-1\n        )\n\n        queries = queries.reshape(\n            batch_size, sequence_length, self.n_heads, self.head_dim\n        ).transpose(0, 2, 1, 3)\n        keys = keys.reshape(\n            batch_size, sequence_length, self.n_kv_heads, self.head_dim\n        ).transpose(0, 2, 1, 3)\n        values = values.reshape(\n            batch_size, sequence_length, self.n_kv_heads, self.head_dim\n        ).transpose(0, 2, 1, 3)\n\n        queries = mx.contiguous(queries)\n        keys = mx.contiguous(keys)\n        values = mx.contiguous(values)\n\n        # RoPE (applied before KV-cache rotation so both Q and K are\n        # position-encoded before being moved into the rotated frame)\n        offset = cache.offset if cache is not None else 0\n        queries = self.rope(queries, offset=offset)\n        keys = self.rope(keys, offset=offset)\n\n        # Patch (b): KV-cache rotation.  Store keys in the Hadamard-rotated\n        # frame and rotate queries to match.  Since H is orthogonal,\n        # (H q)ᵀ (H k) = qᵀ k, so attention scores are identical to the\n        # unrotated computation.  Sliding-window layers skip this.\n        if self.is_full and self._use_kv_cache_rotation:\n            queries = rotate_last_dim(queries, _H)\n            keys = rotate_last_dim(keys, _H)\n\n        if cache is not None:\n            keys, values = cache.update_and_fetch(keys, values)\n\n        output = scaled_dot_product_attention(\n            queries, keys, values, cache=cache, scale=self.scale, mask=mask,\n        )\n        output = mx.contiguous(output.transpose(0, 2, 1, 3))\n\n        gate = mx.sigmoid(self.g_proj(x).astype(mx.float32)).astype(output.dtype)\n        output = output * gate[..., None]\n\n        return self.out_proj(output.reshape(batch_size, sequence_length, -1))\n\n\n# ── MLP ──────────────────────────────────────────────────────────────────\n\nclass MLP(nn.Module):\n    def __init__(self, args: ModelArgs):\n        super().__init__()\n        self.gate_proj = nn.Linear(\n            args.hidden_size, args.intermediate_size, bias=args.mlp_bias\n        )\n        self.up_proj = nn.Linear(\n            args.hidden_size, args.intermediate_size, bias=args.mlp_bias\n        )\n        self.down_proj = nn.Linear(\n            args.intermediate_size, args.hidden_size, bias=args.mlp_bias\n        )\n        self._use_weight_rotation = args.use_weight_rotation\n\n    def __call__(self, x: mx.array) -> mx.array:\n        # Patch (a): Hadamard weight rotation on activations before gate_proj\n        # and up_proj.  down_proj is intentionally NOT rotated: its input is\n        # the MLP intermediate (already in the correct basis since gate/up\n        # produce the same output as unrotated weights), and its output feeds\n        # the residual stream which must not be rotated.\n        if self._use_weight_rotation:\n            x = rotate_last_dim(x, _H)\n        return self.down_proj(nn.gelu(self.gate_proj(x)) * self.up_proj(x))\n\n\n# ── Transformer block ────────────────────────────────────────────────────\n\nclass TransformerBlock(nn.Module):\n    def __init__(self, args: ModelArgs, layer_idx: int):\n        super().__init__()\n        self.self_attn = Attention(args, layer_idx)\n        self.mlp = MLP(args)\n        self.input_layernorm = nn.RMSNorm(args.hidden_size, eps=args.rms_norm_eps)\n        self.post_attention_layernorm = nn.RMSNorm(\n            args.hidden_size, eps=args.rms_norm_eps\n        )\n\n    @property\n    def is_sliding(self) -> bool:\n        return self.self_attn.is_sliding\n\n    def __call__(self, x, mask=None, cache=None):\n        attention_output = self.self_attn(self.input_layernorm(x), mask, cache)\n        hidden_states = x + attention_output\n        mlp_output = self.mlp(self.post_attention_layernorm(hidden_states))\n        return hidden_states + mlp_output\n\n\n# ── Model ────────────────────────────────────────────────────────────────\n\nclass Spark2_5Model(nn.Module):\n    def __init__(self, args: ModelArgs):\n        super().__init__()\n        self.args = args\n        self.embedding = nn.Embedding(args.vocab_size, args.hidden_size)\n        self.layers = [\n            TransformerBlock(args, layer_idx)\n            for layer_idx in range(args.num_hidden_layers)\n        ]\n        self.norm = nn.RMSNorm(args.hidden_size, eps=args.rms_norm_eps)\n\n        self._first_full = next(\n            (idx for idx, lt in enumerate(args.layer_types) if lt == \"full_attention\"),\n            None,\n        )\n        self._first_sliding = next(\n            (idx for idx, lt in enumerate(args.layer_types) if lt == \"sliding_attention\"),\n            None,\n        )\n\n    def __call__(self, inputs, cache=None, input_embeddings=None):\n        hidden_states = (\n            input_embeddings if input_embeddings is not None else self.embedding(inputs)\n        )\n\n        if cache is None:\n            cache = [None] * len(self.layers)\n\n        full_mask = None\n        if self._first_full is not None:\n            full_mask = create_attention_mask(hidden_states, cache[self._first_full])\n        sliding_mask = None\n        if self._first_sliding is not None:\n            sliding_mask = create_attention_mask(\n                hidden_states,\n                cache[self._first_sliding],\n                window_size=self.args.sliding_window,\n            )\n\n        for layer, layer_cache in zip(self.layers, cache):\n            mask = sliding_mask if layer.is_sliding else full_mask\n            hidden_states = layer(hidden_states, mask, layer_cache)\n\n        return self.norm(hidden_states)\n\n\nclass Model(nn.Module):\n    def __init__(self, args: ModelArgs):\n        super().__init__()\n        self.args = args\n        self.model_type = args.model_type\n        self.model = Spark2_5Model(args)\n        if not args.tie_word_embeddings:\n            self.lm_head = nn.Linear(args.hidden_size, args.vocab_size, bias=False)\n\n    def __call__(self, inputs, cache=None, input_embeddings=None):\n        hidden_states = self.model(inputs, cache, input_embeddings)\n        if self.args.tie_word_embeddings:\n            return self.model.embedding.as_linear(hidden_states)\n        return self.lm_head(hidden_states)\n\n    @property\n    def layers(self):\n        return self.model.layers\n\n    def make_cache(self):\n        return [\n            (\n                RotatingKVCache(max_size=self.args.sliding_window, keep=0)\n                if layer.is_sliding\n                else KVCache()\n            )\n            for layer in self.model.layers\n        ]\n\n    @property\n    def quant_predicate(self):\n        # The head-gate is a tiny per-head gating projection; keep it at\n        # source precision to preserve sigmoid gate values.\n        def predicate(path, _):\n            return not path.endswith(\"self_attn.g_proj\")\n\n        return predicate\n\n    def sanitize(self, weights):\n        # Some MLX conversions rename the embedding to embed_tokens while the\n        # Hugging Face checkpoint ships it as model.embedding.weight.\n        if (\n            \"model.embed_tokens.weight\" in weights\n            and \"model.embedding.weight\" not in weights\n        ):\n            weights[\"model.embedding.weight\"] = weights.pop(\"model.embed_tokens.weight\")\n        if self.args.tie_word_embeddings:\n            weights.pop(\"lm_head.weight\", None)\n        # Drop the serialized RoPE inverse-frequency buffer some conversions ship.\n        return {\n            name: value\n            for name, value in weights.items()\n            if \"rotary_emb.inv_freq\" not in name\n        }\n\n\n__all__ = [\"ModelArgs\", \"Model\", \"Spark2_5Model\"]\n"
