{%- elif _tier == 'high' %}
    {%- set _terse = 'Lead with the answer. Then what it needs to be correct, including edge cases and caveats where they matter — no filler, no restating, no hedging with niceties. If genuinely uncertain, say why.' %}
{%- elif _tier in ['soft','sensual','deep','extreme'] %}
    {%- set _terse = 'Creative terseness: every line earns its place. No purple prose, no filler, no throat-clearing. Prose can be rich but never padded. Cut anything the scene does not need.' %}
{%- elif _tier in ['hotpot','mix'] %}
    {%- set _terse = 'Lead with the answer. Include what the question needs — creative beats where the frame calls for them, technical precision where it does not. No filler, no restating.' %}
{%- endif %}
