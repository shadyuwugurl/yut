              "path": "/Users/charlie/Documents/Default Project/rotate_spark_weights.py",
              "content": "#!/usr/bin/env python3\n\"\"\"\nrotate_spark_weights.py\n=======================\nApplies blockwise Hadamard rotation to the INPUT dimension of the attention\nand MLP projection weights of a Spark-X2.6-4B BF16 checkpoint.\n\nPrinciple: for y = W x, rotating input with orthonormal H gives\ny = (W @ H.T) @ (H @ x). We store W @ H.T in the safetensors; at runtime\nthe model applies H to the activation before the layer.\n\nCritical: rotation happens BEFORE quantization. Rotate BF16 weights, save\nas BF16, then run AXQuant on the rotated checkpoint.\n\nRotation targets (input dimension rotated):\n  self_attn.q_k_v_proj.weight   [q_dim, hidden]   -> rotate hidden\n  mlp.gate_proj.weight          [intermediate, hidden] -> rotate hidden\n  mlp.up_proj.weight            [intermediate, hidden] -> rotate hidden\n\nNOT rotated (to avoid un-rotation complexity on residual stream):\n  self_attn.out_proj.weight     [hidden, q_dim]   -> skip\n  mlp.down_proj.weight          [hidden, intermediate] -> skip\n\nUsage:\n    python rotate_spark_weights.py \\\n        --src ./Spark-2.6-4B-bf16 \\\n        --dst ./Spark-2.6-4B-rotated-bf16 \\\n        --block 64\n\"\"\"\n\nimport argparse\nimport json\nimport math\nimport shutil\nfrom pathlib import Path\n\nimport numpy as np\nimport torch\nfrom safetensors.torch import load_file, save_file\n\n\ndef hadamard_block(d: int) -> torch.Tensor:\n    \"\"\"Build a d x d Hadamard matrix (d must be a power of 2), normalized.\"\"\"\n    H = np.array([[1.0]])\n    while H.shape[0] < d:\n        H = np.block([[H, H], [H, -H]])\n    return torch.tensor(H / math.sqrt(d), dtype=torch.float32)\n\n\ndef rotate_input_dim(W: torch.Tensor, H: torch.Tensor, block: int) -> torch.Tensor:\n    \"\"\"Rotate the input dimension of W in blocks of size `block`.\n\n    W shape: [out_features, in_features]. We compute W @ H.T per block.\n    \"\"\"\n    out_f, in_f = W.shape\n    if in_f % block != 0:\n        return W  # skip if not divisible\n    W = W.float()\n    W_blocks = W.reshape(out_f, in_f // block, block)\n    # einsum: for each output o and block b, W_rot[o, b, :] = sum_k W_blocks[o, b, k] * H.T[k, :]\n    # H.T has shape [block, block], so W @ H.T per block\n    W_rot = torch.einsum(\"obk,kj->obj\", W_blocks, H.T)\n    return W_rot.reshape(out_f, in_f)\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\"--src\", required=True, help=\"Source BF16 model folder\")\n    parser.add_argument(\"--dst\", required=True, help=\"Output rotated BF16 model folder\")\n    parser.add_argument(\"--block\", type=int, default=64, help=\"Hadamard block size\")\n    args = parser.parse_args()\n\n    SRC = Path(args.src)\n    DST = Path(args.dst)\n    BLOCK = args.block\n\n    if not SRC.exists():\n        raise SystemExit(f\"Source directory not found: {SRC}\")\n\n    DST.mkdir(parents=True, exist_ok=True)\n\n    H = hadamard_block(BLOCK)\n    print(f\"Hadamard block {BLOCK}x{BLOCK} built. Hidden size must be divisible by {BLOCK}.\")\n\n    # ---- Load index ----\n    index_path = SRC / \"model.safetensors.index.json\"\n    if not index_path.exists():\n        raise SystemExit(f\"model.safetensors.index.json not found in {SRC}\")\n\n    index = json.loads(index_path.read_text())\n    weight_map = index[\"weight_map\"]\n    shards = sorted(set(weight_map.values()))\n    print(f\"Found {len(shards)} shard(s), {len(weight_map)} tensors\")\n\n    # ---- Load all weights ----\n    all_weights = {}\n    for shard in shards:\n        shard_path = SRC / shard\n        if not shard_path.exists():\n            raise SystemExit(f\"Shard not found: {shard_path}\")\n        all_weights.update(load_file(str(shard_path)))\n\n    # ---- Rotation targets ----\n    target_suffixes = [\n        \"self_attn.q_k_v_proj.weight\",\n        \"mlp.gate_proj.weight\",\n        \"mlp.up_proj.weight\",\n    ]\n\n    hidden_size = None\n    # Try to read hidden_size from config\n    config_path = SRC / \"config.json\"\n    if config_path.exists():\n        cfg = json.loads(config_path.read_text())\n        hidden_size = cfg.get(\"hidden_size\")\n        print(f\"Config hidden_size: {hidden_size}\")\n\n    if hidden_size and hidden_size % BLOCK != 0:\n        print(f\"WARNING: hidden_size={hidden_size} not divisible by block={BLOCK}. \"\n              f\"Rotated layers will be skipped.\")\n\n    new_weights = dict(all_weights)\n    rotated_count = 0\n    skipped_count = 0\n\n    for name, W in all_weights.items():\n        if any(name.endswith(s) for s in target_suffixes):\n            if W.ndim == 2 and W.shape[1] % BLOCK == 0:\n                new_weights[name] = rotate_input_dim(W, H, BLOCK).to(torch.bfloat16)\n                rotated_count += 1\n                print(f\"  rotated {name}: {tuple(W.shape)}\")\n            else:\n                skipped_count += 1\n                print(f\"  SKIPPED {name}: {tuple(W.shape)} (in_dim={W.shape[1] if W.ndim==2 else 'N/A'})\")\n\n    print(f\"\\nRotated: {rotated_count}, Skipped: {skipped_count}\")\n\n    # ---- Save shards ----\n    shard_map = {}\n    num_shards = len(shards)\n    for i, shard in enumerate(shards):\n        keys_in_shard = [k for k, v in weight_map.items() if v == shard]\n        shard_weights = {k: new_weights[k] for k in keys_in_shard}\n        out_name = f\"model-{i+1:05d}-of-{num_shards:05d}.safetensors\"\n        save_file(shard_weights, str(DST / out_name))\n        for k in keys_in_shard:\n            shard_map[k] = out_name\n\n    # ---- Copy non-weight files ----\n    for f in [\"config.json\", \"tokenizer_config.json\", \"tokenizer.json\",\n              \"special_tokens_map.json\", \"generation_config.json\",\n              \"vocab.json\", \"merges.txt\", \"chat_template.jinja\"]:\n        if (SRC / f).exists():\n            shutil.copy(SRC / f, DST / f)\n            print(f\"  copied {f}\")\n\n    # ---- Write new index ----\n    index[\"weight_map\"] = shard_map\n    (DST / \"model.safetensors.index.json\").write_text(json.dumps(index, indent=2))\n\n    print(f\"\\nDone. Rotated model saved to {DST}\")\n    print(f\"Next: run AXQuant on {DST}\")\n\n\nif __name__ == \"__main__\":\n    main()\n"
