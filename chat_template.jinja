              "content": "#!/usr/bin/env python3\n\"\"\"\nquantize_spark.py\n=================\nMixed-precision quantization of the Spark-X2.6-4B MLX BF16 model using\nmlx_lm.utils.quantize_model with a per-layer quant_predicate.\n\nTarget mix:\n  MLP (gate/up/down_proj):     4-bit\n  Attention (q_k_v/out_proj):   6-bit\n  Attention gate (g_proj):      skip (too small: last_dim=16 not divisible by 64)\n  Embedding:                    4-bit   (tied → also serves as LM head)\n  Norms / others:               skip (BF16)\n\nResult: ~4.2 bits per weight average.\n\nUsage:\n    python quantize_spark.py \\\n        --model ./Spark-2.6-4B-mlx-bf16 \\\n        --output ./Spark-2.6-4B-AXQ-rotated \\\n        --group-size 64\n\"\"\"\n\nimport argparse\nimport copy\nimport json\nimport shutil\nfrom pathlib import Path\n\nimport mlx.core as mx\nimport mlx.nn as nn\nfrom mlx_lm.utils import load_model, save_model, quantize_model\n\n\n# ---- Bit-width assignment by layer path suffix ----\nMLP_SUFFIXES = (\n    \"mlp.gate_proj\",\n    \"mlp.up_proj\",\n    \"mlp.down_proj\",\n)\nATTN_SUFFIXES = (\n    \"self_attn.q_k_v_proj\",\n    \"self_attn.out_proj\",\n)\nEMBED_SUFFIX = \"embedding.weight\"\nSKIP_SUFFIXES = (\n    \"input_layernorm.weight\",\n    \"post_attention_layernorm.weight\",\n    \"norm.weight\",\n    \"self_attn.g_proj\",   # last_dim=16, not divisible by group_size=64\n    \"rotary_emb\",         # RoPE buffers, not quantized\n)\n\n\ndef quant_predicate(path: str, module: nn.Module):\n    \"\"\"Return per-layer quantization params dict, or False to skip.\"\"\"\n    # Only quantize Linear-like layers that have to_quantized\n    if not hasattr(module, \"to_quantized\"):\n        return False\n\n    # Skip norms and small layers\n    if any(path.endswith(s) for s in SKIP_SUFFIXES):\n        return False\n\n    # MLP → 4-bit\n    if any(path.endswith(s) for s in MLP_SUFFIXES):\n        return {\"group_size\": 64, \"bits\": 4, \"mode\": \"affine\"}\n\n    # Attention projections → 6-bit\n    if any(path.endswith(s) for s in ATTN_SUFFIXES):\n        return {\"group_size\": 64, \"bits\": 6, \"mode\": \"affine\"}\n\n    # Embedding (tied, also LM head) → 4-bit\n    if path.endswith(EMBED_SUFFIX):\n        return {\"group_size\": 64, \"bits\": 4, \"mode\": \"affine\"}\n\n    # Everything else: skip\n    return False\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\"--model\", required=True, help=\"Input MLX BF16 model dir\")\n    parser.add_argument(\"--output\", required=True, help=\"Output quantized model dir\")\n    parser.add_argument(\"--group-size\", type=int, default=64, help=\"Quantization group size\")\n    args = parser.parse_args()\n\n    model_path = Path(args.model)\n    output_path = Path(args.output)\n    output_path.mkdir(parents=True, exist_ok=True)\n\n    print(f\"Loading model from {model_path} ...\")\n    model, config = load_model(model_path, trust_remote_code=True)\n    print(f\"Model loaded. Layers: {len(model.layers) if hasattr(model, 'layers') else 'N/A'}\")\n\n    print(\"\\nApplying mixed-precision quantization...\")\n    print(\"  MLP (gate/up/down):      4-bit\")\n    print(\"  Attention (q_k_v/out):    6-bit\")\n    print(\"  Embedding (tied):         4-bit\")\n    print(\"  Norms / g_proj / RoPE:    skip (BF16)\")\n    print()\n\n    model, quantized_config = quantize_model(\n        model,\n        config,\n        group_size=args.group_size,\n        bits=None,  # per-layer via predicate\n        mode=\"affine\",\n        quant_predicate=quant_predicate,\n    )\n\n    # Save quantized weights\n    print(f\"\\nSaving quantized model to {output_path} ...\")\n    save_model(output_path, model)\n\n    # Save updated config with quantization block\n    config_path = output_path / \"config.json\"\n    with open(config_path, \"w\") as f:\n        json.dump(quantized_config, f, indent=2)\n    print(f\"Saved config.json with quantization block\")\n\n    # Copy non-weight files\n  