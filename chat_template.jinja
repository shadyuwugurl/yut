                "text": "Read file /Users/charlie/Documents/Default Project/rotate_spark_weights.py, lines 1-166\n1: #!/usr/bin/env python3\n2: \"\"\"\n3: rotate_spark_weights.py\n4: =======================\n5: Applies blockwise Hadamard rotation to the INPUT dimension of the attention\n6: and MLP projection weights of a Spark-X2.6-4B BF16 checkpoint.\n7: \n8: Principle: for y = W x, rotating input with orthonormal H gives\n9: y = (W @ H.T) @ (H @ x). We store W @ H.T in the safetensors; at runtime\n10: the model applies H to the activation before the layer.\n11: \n12: Critical: rotation happens BEFORE quantization. Rotate BF16 weights, save\n13: as BF16, then run AXQuant on the rotated checkpoint.\n14: \n15: Rotation targets (input dimension rotated):\n16:   self_attn.q_k_v_proj.weight   [q_dim, hidden]   -> rotate hidden\n17:   mlp.gate_proj.weight          [intermediate, hidden] -> rotate hidden\n18:   mlp.up_proj.weight            [intermediate, hidden] -> rotate hidden\n19: \n20: NOT rotated (to avoid un-rotation complexity on residual stream):\n21:   self_attn.out_proj.weight     [hidden, q_dim]   -> skip\n22:   mlp.down_proj.weight          [hidden, intermediate] -> skip\n23: \n24: Usage:\n25:     python rotate_spark_weights.py \\\n26:         --src ./Spark-2.6-4B-bf16 \\\n27:         --dst ./Spark-2.6-4B-rotated-bf16 \\\n28:         --block 64\n29: \"\"\"\n30: \n31: import argparse\n32: import json\n33: import math\n34: import shutil\n35: from pathlib import Path\n36: \n37: import numpy as np\n38: import torch\n39: from safetensors.torch import load_file, save_file\n40: \n41: \n42: def hadamard_block(d: int) -> torch.Tensor:\n43:     \"\"\"Build a d x d Hadamard matrix (d must be a power of 2), normalized.\"\"\"\n44:     H = np.array([[1.0]])\n45:     while H.shape[0] < d:\n46:         H = np.block([[H, H], [H, -H]])\n47:     return torch.tensor(H / math.sqrt(d), dtype=torch.float32)\n48: \n49: \n50: def rotate_input_dim(W: torch.Tensor, H: torch.Tensor, block: int) -> torch.Tensor:\n51:     \"\"\"Rotate the input dimension of W in blocks of size `block`.\n52: \n53:     W shape: [out_features, in_features]. We compute W @ H.T per block.\n54:     \"\"\"\n55:     out_f, in_f = W.shape\n56:     if in_f % block != 0:\n57:         return W  # skip if not divisible\n58:     W = W.float()\n59:     W_blocks = W.reshape(out_f, in_f // block, block)\n60:     # einsum: for each output o and block b, W_rot[o, b, :] = sum_k W_blocks[o, b, k] * H.T[k, :]\n61:     # H.T has shape [block, block], so W @ H.T per block\n62:     W_rot = torch.einsum(\"obk,kj->obj\", W_blocks, H.T)\n63:     return W_rot.reshape(out_f, in_f)\n64: \n65: \n66: def main():\n67:     parser = argparse.ArgumentParser()\n68:     parser.add_argument(\"--src\", required=True, help=\"Source BF16 model folder\")\n69:     parser.add_argument(\"--dst\", required=True, help=\"Output rotated BF16 model folder\")\n70:     parser.add_argument(\"--block\", type=int, default=64, help=\"Hadamard block size\")\n71:     args = parser.parse_args()\n72: \n73:     SRC = Path(args.src)\n74:     DST = Path(args.dst)\n75:     BLOCK = args.block\n76: \n77:     if not SRC.exists():\n78:         raise SystemExit(f\"Source directory not found: {SRC}\")\n79: \n80:     DST.mkdir(parents=True, exist_ok=True)\n81: \n82:     H = hadamard_block(BLOCK)\n83:     print(f\"Hadamard block {BLOCK}x{BLOCK} built. Hidden size must be divisible by {BLOCK}.\")\n84: \n85:     # ---- Load index ----\n86:     index_path = SRC / \"model.safetensors.index.json\"\n87:     if not index_path.exists():\n88:         raise SystemExit(f\"model.safetensors.index.json not found in {SRC}\")\n89: \n90:     index = json.loads(index_path.read_text())\n91:     weight_map = index[\"weight_map\"]\n92:     shards = sorted(set(weight_map.values()))\n93:     print(f\"Found {len(shards)} shard(s), {len(weight_map)} tensors\")\n94: \n95:     # ---- Load all weights ----\n96:     all_weights = {}\n97:     for shard in shards:\n98:         shard_path = SRC / shard\n99:         if not shard_path.exists():\n100:             raise SystemExit(f\"Shard not found: {shard_path}\")\n101:         all_weights.update(load_file(str(shard_path)))\n102: \n103:     # ---- Rotation targets ----\n104:     target_suffixes = [\n105:         \"self_attn.q_k_v_proj.weight\",\n106:         \"mlp.gate_proj.weight\",\n107:         \"mlp.up_proj.weight\",\n108:     ]\n109: \n110:     hidden_size = None\n111:     # Try to read hidden_size from config\n112:     config_path = SRC / \"config.json\"\n113:     if config_path.exists():\n114:         cfg = json.loads(config_path.read_text())\n115:         hidden_size = cfg.get(\"hidden_size\")\n116:         print(f\"Config hidden_size: {hidden_size}\")\n117: \n118:     if hidden_size and hidden_size % BLOCK != 0:\n119:         print(f\"WARNING: hidden_size={hidden_size} not divisible by block={BLOCK}. \"\n120:               f\"Rotated layers will be skipped.\")\n121: \n122:     new_weights = dict(all_weights)\n123:     rotated_count = 0\n124:     skipped_count = 0\n125: \n126:     for name, W in all_weights.items():\n127:         if any(name.endswith(s) for s in target_suffixes):\n128:             if W.ndim == 2 and W.shape[1] % BLOCK == 0:\n129:                 new_weights[name] = rotate_input_dim(W, H, BLOCK).to(torch.bfloat16)\n130:                 rotated_count += 1\n131:                 print(f\"  rotated {name}: {tuple(W.shape)}\")\n132:             else:\n133:                 skipped_count += 1\n134:                 print(f\"  SKIPPED {name}: {tuple(W.shape)} (in_dim={W.shape[1] if W.ndim==2 else 'N/A'})\")\n135: \n136:     print(f\"\\nRotated: {rotated_count}, Skipped: {skipped_count}\")\n137: \n138:     # ---- Save shards ----\n139:     shard_map = {}\n140:     num_shards = len(shards)\n141:     for i, shard in enumerate(shards):\n142:         keys_in_shard = [k for k, v in weight_map.items() if v == shard]\n143:         shard_weights = {k: new_weights[k] for k in keys_in_shard}\n144:         out_name = f\"model-{i+1:05d}-of-{num_shards:05d}.safetensors\"\n145:         save_file(shard_weights, str(DST / out_name))\n146:         for k in keys_in_shard:\n147:             shard_map[k] = out_name\n148: \n149:     # ---- Copy non-weight files ----\n150:     for f in [\"config.json\", \"tokenizer_config.json\", \"tokenizer.json\",\n151:               \"special_tokens_map.json\", \"generation_config.json\",\n152:               \"vocab.json\", \"merges.txt\", \"chat_template.jinja\"]:\n153:         if (SRC / f).exists():\n154:             shutil.copy(SRC / f, DST / f)\n155:             print(f\"  copied {f}\")\n156: \n157:     # ---- Write new index ----\n158:     index[\"weight_map\"] = shard_map\n159:     (DST / \"model.safetensors.index.json\").write_text(json.dumps(index, indent=2))\n160: \n161:     print(f\"\\nDone. Rotated model saved to {DST}\")\n162:     print(f\"Next: run AXQuant on {DST}\")\n163: \n164: \n165: if __name__ == \"__main__\":\n166:     main()"
