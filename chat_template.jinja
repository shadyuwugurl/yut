                "text": "Read file /Users/charlie/Documents/Default Project/quantize_spark.py, lines 1-144\n1: #!/usr/bin/env python3\n2: \"\"\"\n3: quantize_spark.py\n4: =================\n5: Mixed-precision quantization of the Spark-X2.6-4B MLX BF16 model using\n6: mlx_lm.utils.quantize_model with a per-layer quant_predicate.\n7: \n8: Target mix:\n9:   MLP (gate/up/down_proj):     4-bit\n10:   Attention (q_k_v/out_proj):   6-bit\n11:   Attention gate (g_proj):      skip (too small: last_dim=16 not divisible by 64)\n12:   Embedding:                    4-bit   (tied → also serves as LM head)\n13:   Norms / others:               skip (BF16)\n14: \n15: Result: ~4.2 bits per weight average.\n16: \n17: Usage:\n18:     python quantize_spark.py \\\n19:         --model ./Spark-2.6-4B-mlx-bf16 \\\n20:         --output ./Spark-2.6-4B-AXQ-rotated \\\n21:         --group-size 64\n22: \"\"\"\n23: \n24: import argparse\n25: import copy\n26: import json\n27: import shutil\n28: from pathlib import Path\n29: \n30: import mlx.core as mx\n31: import mlx.nn as nn\n32: from mlx_lm.utils import load_model, save_model, quantize_model\n33: \n34: \n35: # ---- Bit-width assignment by layer path suffix ----\n36: MLP_SUFFIXES = (\n37:     \"mlp.gate_proj\",\n38:     \"mlp.up_proj\",\n39:     \"mlp.down_proj\",\n40: )\n41: ATTN_SUFFIXES = (\n42:     \"self_attn.q_k_v_proj\",\n43:     \"self_attn.out_proj\",\n44: )\n45: EMBED_SUFFIX = \"embedding.weight\"\n46: SKIP_SUFFIXES = (\n47:     \"input_layernorm.weight\",\n48:     \"post_attention_layernorm.weight\",\n49:     \"norm.weight\",\n50:     \"self_attn.g_proj\",   # last_dim=16, not divisible by group_size=64\n51:     \"rotary_emb\",         # RoPE buffers, not quantized\n52: )\n53: \n54: \n55: def quant_predicate(path: str, module: nn.Module):\n56:     \"\"\"Return per-layer quantization params dict, or False to skip.\"\"\"\n57:     # Only quantize Linear-like layers that have to_quantized\n58:     if not hasattr(module, \"to_quantized\"):\n59:         return False\n60: \n61:     # Skip norms and small layers\n62:     if any(path.endswith(s) for s in SKIP_SUFFIXES):\n63:         return False\n64: \n65:     # MLP → 4-bit\n66:     if any(path.endswith(s) for s in MLP_SUFFIXES):\n67:         return {\"group_size\": 64, \"bits\": 4, \"mode\": \"affine\"}\n68: \n69:     # Attention projections → 6-bit\n70:     if any(path.endswith(s) for s in ATTN_SUFFIXES):\n71:         return {\"group_size\": 64, \"bits\": 6, \"mode\": \"affine\"}\n72: \n73:     # Embedding (tied, also LM head) → 4-bit\n74:     if path.endswith(EMBED_SUFFIX):\n75:         return {\"group_size\": 64, \"bits\": 4, \"mode\": \"affine\"}\n76: \n77:     # Everything else: skip\n78:     return False\n79: \n80: \n81: def main():\n82:     parser = argparse.ArgumentParser()\n83:     parser.add_argument(\"--model\", required=True, help=\"Input MLX BF16 model dir\")\n84:     parser.add_argument(\"--output\", required=True, help=\"Output quantized model dir\")\n85:     parser.add_argument(\"--group-size\", type=int, default=64, help=\"Quantization group size\")\n86:     args = parser.parse_args()\n87: \n88:     model_path = Path(args.model)\n89:     output_path = Path(args.output)\n90:     output_path.mkdir(parents=True, exist_ok=True)\n91: \n92:     print(f\"Loading model from {model_path} ...\")\n93:     model, config = load_model(model_path, trust_remote_code=True)\n94:     print(f\"Model loaded. Layers: {len(model.layers) if hasattr(model, 'layers') else 'N/A'}\")\n95: \n96:     print(\"\\nApplying mixed-precision quantization...\")\n97:     print(\"  MLP (gate/up/down):      4-bit\")\n98:     print(\"  Attention (q_k_v/out):    6-bit\")\n99:     print(\"  Embedding (tied):         4-bit\")\n100:     print(\"  Norms / g_proj / RoPE:    skip (BF16)\")\n101:     print()\n102: \n103:     model, quantized_config = quantize_model(\n104:         model,\n105:         config,\n106:         group_size=args.group_size,\n107:         bits=None,  # per-layer via predicate\n108:         mode=\"affine\",\n109:         quant_predicate=quant_predicate,\n110:     )\n111: \n112:     # Save quantized weights\n113:     print(f\"\\nSaving quantized model to {output_path} ...\")\n114:     save_model(output_path, model)\n115: \n116:     # Save updated config with quantization block\n117:     config_path = output_path / \"config.json\"\n118:     with open(config_path, \"w\") as f:\n119:         json.dump(quantized_config, f, indent=2)\n120:     print(f\"Saved config.json with quantization block\")\n121: \n122:     # Copy non-weight files\n123:     for f in [\n124:         \"tokenizer_config.json\", \"tokenizer.json\",\n125:         \"special_tokens_map.json\", \"generation_config.json\",\n126:         \"vocab.json\", \"merges.txt\", \"chat_template.jinja\",\n127:     ]:\n128:         src = model_path / f\n129:         if src.exists():\n130:             shutil.copy(src, output_path / f)\n131:             print(f\"  copied {f}\")\n132: \n133:     # Also copy configuration_spark.py if it exists (for trust_remote_code)\n134:     src = model_path / \"configuration_spark.py\"\n135:     if src.exists():\n136:         shutil.copy(src, output_path / src.name)\n137:         print(f\"  copied configuration_spark.py\")\n138: \n139:     print(\"\\nDone. Quantized model saved to\", output_path)\n140:     print(\"\\nNext step: write custom modeling_spark.py with weight rotation + KV cache rotation + YaRN\")\n141: \n142: \n143: if __name__ == \"__main__\":\n144:     main()"
