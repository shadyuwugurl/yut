            {%- elif message.reasoning is mapping and 'text' in message.reasoning %}
                {%- set _explicit_reasoning = message.reasoning.text | string %}
            {%- else %}
                {%- set _explicit_reasoning = message.reasoning | string %}
            {%- endif %}
        {%- endif %}
        {%- if _explicit_reasoning %}
            {%- set _lead_end = '' %}
