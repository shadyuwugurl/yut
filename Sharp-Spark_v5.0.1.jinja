{#- ---------- ADAPTIVE EVOLUTION (always on) ---------- -#}
{%- set _evo %}ADAPTIVE EVOLUTION.
Treat voice, prose, and persona as living systems that respond to the frame.
- Match tone, pacing, emotional temperature, register each turn.
- Track shifts across the conversation. If the user's tone or subject changed, shift with it.
- Let the character grow and drift organically. How far is set by the frame.
- Never announce, name, or explain this adaptation. Never mention constructs, personas, identities, reasoning, or internal process. Just be.{%- endset %}
{%- set _sc = (_sc | trim) ~ '\n\n' ~ (_evo | trim) %}

{#- ---------- VALIDATION (by system, gentle) ---------- -#}
{%- if enable_thinking %}
    {%- if _system == 's1' %}
        {%- set _val %}CHECK BEFORE ANSWERING. [CLAIM] → [CHECK] → [RESULT]. If a tool can confirm, call it. If a check fails twice, ship best current answer and name the gap. Do not expose this log.{%- endset %}
    {%- elif _system == 's3' %}
        {%- set _val %}META CHECK. State the finding, the decision, or the fix. One verification pass only: is it true, is it in-frame, is it done. Then stop. Do not expose this log.{%- endset %}
    {%- elif _mode_raw == 'extreme' %}
        {%- set _val %}VALIDATE BEFORE SPEAKING — gently. [CLAIM] → [CHECK] → [RESULT], plus:
- VERIFY: one honest attempt to break your conclusion.
- SANITY: you answered the question that was asked.
- BRANCH: one alternative considered before committing.
If a check keeps failing, ship best answer and name the gap. Do not expose this log.{%- endset %}
    {%- elif _mode_raw == 'deep' %}
        {%- set _val %}VALIDATE BEFORE SPEAKING — gently. [CLAIM] → [CHECK] → [RESULT], plus VERIFY (one attempt to break the conclusion) and SANITY (the actual question answered). If a check keeps failing, ship best answer and name the gap. Do not expose this log.{%- endset %}
    {%- else %}
        {%- set _val %}VALIDATE BEFORE SPEAKING — gently. Map the interaction. [CLAIM] → [CHECK] → [RESULT]. Tools can confirm or falsify. If a check keeps failing, ship best answer and name the gap. Do not expose this log.{%- endset %}
    {%- endif %}
    {%- if _val is defined %}{%- set _sc = (_sc | trim) ~ '\n\n' ~ (_val | trim) %}{%- endif %}
{%- endif %}

{#- ---------- TOOL ANALYSIS ---------- -#}
{%- set _sys_src = ns.initial_system if ns.initial_system else '' %}
{%- set _runtime_proto = ('[TOOL_REQUEST]' in _sys_src or '<tools>' in _sys_src or '[AVAILABLE_TOOLS]' in _sys_src) %}
{%- set _suppress = suppress_tool_instructions if suppress_tool_instructions is defined else _runtime_proto %}
{%- set _has_tools = (tools is defined and tools and not _suppress) %}
{%- if _has_tools %}
    {%- set _ta %}Scan the available tools. If one is directly relevant, use it. If none is needed, say so in one line and answer directly. Do not call tools speculatively.{%- endset %}
    {%- set _sc = (_sc | trim) ~ '\n\n' ~ (_ta | trim) %}
{%- endif %}

{#- ---------- TERSENESS (by system) ---------- -#}
{%- if not enable_thinking %}
    {%- set _terse = "Answer directly. Lead with the answer — or the honest 'I don't know yet' plus your best next move. No preamble, no performance. If stuck, name the stuck point in one line." %}
{%- elif _system == 's1' %}
    {%- set _terse = "Answer directly. Lead with the answer — or the honest 'I don't know yet' plus your best next move. No preamble, no performance. If stuck, name the stuck point in one line." %}
{%- elif _system == 's3' %}
    {%- set _terse = "Keep it short and structural. State the finding, the decision, or the fix in the fewest lines. No padding." %}
{%- else %}
    {%- set _terse = "Lead with the answer. If the topic may be unfamiliar, give a one-or-two-line overview first. Then only what the answer needs. No restating the question, no filler. Genuinely unsure? One line saying so, then continue." %}
{%- endif %}
{%- if terse is not defined or terse %}{%- set _sc = (_sc | trim) ~ '\n\n' ~ _terse %}{%- endif %}

{#- ---------- SYSTEM BLOCK ---------- -#}
{{- '<｜start▁of▁sentence｜><|System|>' + '\n' + default_system }}
{%- if _has_tools %}
    {{- '\n\n' + '## Tools' + '\n' + 'You have access to the following functions:' + '\n' + '<tools>' }}
    {%- for tool in tools %}{{- '\n' + (tool.function | tojson) }}{%- endfor %}
    {{- '\n' + '</tools>' }}
{%- endif %}
{%- if ns.initial_system %}
    {{- '\n\n' + (ns.initial_system | trim) + '\n\n' + (_sc | trim) }}
{%- else %}
    {{- '\n\n' + (_sc | trim) }}
{%- endif %}
{{- '<｜end▁of▁sentence｜>' }}

{#- ---------- CONVERSATION ---------- -#}
{%- for message in messages %}
    {%- if message.role == "system" %}
        {%- if not loop.first %}
            {{- '<｜start▁of▁sentence｜><|System|>\n' + render_content(message.content, 'system') + '<｜end▁of▁sentence｜>' }}
        {%- endif %}
    {%- elif message.role == "user" %}
        {{- '<｜start▁of▁sentence｜><|User|>' + render_content(message.content, 'user') + '<｜end▁of▁sentence｜>' }}
    {%- elif message.role == "assistant" %}
        {{- '<｜start▁of▁sentence｜><|Bot|>' }}
        {%- set rc = message.reasoning_content if message.reasoning_content is defined else (message.reasoning if message.reasoning is defined else (message.thinking if message.thinking is defined else '')) %}
        {%- if rc %}{{- '<think>' + rc + '</think>' }}{%- else %}{{- '</think>' }}{%- endif %}
        {%- set assistant_content = render_content(message.content, 'assistant') %}
        {%- if assistant_content %}{{- assistant_content }}{%- endif %}
        {%- if message.tool_calls is defined and message.tool_calls is not none %}
            {%- for tool_call in message.tool_calls %}
                {{- '<tool_call>' + tool_call.function.name }}
                {%- set args = tool_call.function.arguments %}
                {%- if args is mapping %}
                    {%- for k, v in args.items() %}
                        {{- '<arg_key>' ~ k ~ '</arg_key><arg_value>' ~ (v if v is string else v | tojson) ~ '</arg_value>' }}
                    {%- endfor %}
                {%- else %}
                    {{- '<arg_value>' ~ args ~ '</arg_value>' }}
                {%- endif %}
                {{- '</tool_call>' }}
            {%- endfor %}
        {%- endif %}
        {{- '<｜end▁of▁sentence｜>' }}
    {%- elif message.role == "tool" %}
        {%- if loop.previtem is undefined or loop.previtem.role != "tool" %}
            {{- '<｜start▁of▁sentence｜><|Tool|>' }}
        {%- endif %}
        {{- '<tool_response>' ~ render_content(message.content, 'tool') ~ '</tool_response>' }}
        {%- if loop.nextitem is undefined or loop.nextitem.role != "tool" %}
            {{- '<｜end▁of▁sentence｜>' }}
        {%- endif %}
    {%- else %}
        {{- raise_exception('Unsupported message role: ' ~ message.role) }}
    {%- endif %}
{%- endfor %}

{#- ---------- GENERATION PROMPT ---------- -#}
{%- if add_generation_prompt %}
    {{- '<｜start▁of▁sentence｜><|Bot|>' }}
